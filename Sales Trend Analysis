import pandas as pd
import matplotlib.pyplot as plt

# Load sales data
sales = pd.read_csv("sales.csv")
sales["Date"] = pd.to_datetime(sales["Date"])
sales["SalesAmount"] = sales["SalesAmount"].fillna(0)

# Weekly and monthly resampling
weekly_sales = sales.resample("W", on="Date")["SalesAmount"].sum()
monthly_sales = sales.resample("ME", on="Date")["SalesAmount"].sum()


# Plot weekly sales trend
plt.figure(figsize=(12,6))
plt.plot(weekly_sales.index, weekly_sales.values, marker="o", linestyle="-", color="blue")
plt.title("Weekly Sales Trend")
plt.xlabel("Week")
plt.ylabel("Total Sales")
plt.grid(True)
plt.tight_layout()
plt.show()

# Plot monthly sales trend
plt.figure(figsize=(12,6))
plt.plot(monthly_sales.index, monthly_sales.values, marker="o", linestyle="-", color="green")
plt.title("Monthly Sales Trend")
plt.xlabel("Month")
plt.ylabel("Total Sales")
plt.grid(True)
plt.tight_layout()
plt.show()

# Rolling average for daily sales
sales["7DayAvg"] = sales["SalesAmount"].rolling(window=7).mean()

plt.figure(figsize=(12,6))
plt.plot(sales["Date"], sales["SalesAmount"], alpha=0.5, label="Daily Sales")
plt.plot(sales["Date"], sales["7DayAvg"], color="red", linewidth=2, label="7-Day Rolling Avg")
plt.title("Daily Sales with 7-Day Rolling Average")
plt.xlabel("Date")
plt.ylabel("Sales Amount")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()


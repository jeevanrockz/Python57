import pandas as pd

# Step 1: Load data
sales = pd.read_csv("sales.csv")
sales["Date"] = pd.to_datetime(sales["Date"])

# Step 2: Clean data
sales["SalesAmount"] = sales["SalesAmount"].fillna(0)

# Step 3: Resample by week and month
weekly_sales = sales.resample("W", on="Date")["SalesAmount"].sum()
monthly_sales = sales.resample("ME", on="Date")["SalesAmount"].sum()

# Step 4: Rolling average (7-day trend)
sales["7DayAvg"] = sales["SalesAmount"].rolling(window=7).mean()

# Step 5: Store comparison
store_summary = sales.groupby("StoreID")["SalesAmount"].mean().sort_values(ascending=False)

# Step 6: Export results
weekly_sales.to_csv("weekly_sales.csv")
monthly_sales.to_csv("monthly_sales.csv")
store_summary.to_csv("store_summary.csv")

print("✅ Sales trend analysis completed successfully!")


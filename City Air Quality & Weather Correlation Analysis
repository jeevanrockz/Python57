import pandas as pd

# Step 1: Load datasets
air_quality = pd.read_csv("air_quality.csv")
weather = pd.read_csv("weather.csv")

# Step 2: Clean data
air_quality["Date"] = pd.to_datetime(air_quality["Date"])
weather["Date"] = pd.to_datetime(weather["Date"])

# Step 3: Merge datasets
data = pd.merge(air_quality, weather, on=["Date", "City"], how="inner")

# Step 4: Correlation analysis
correlation_matrix = data[["AQI", "Temperature", "Humidity", "WindSpeed"]].corr()

# Step 5: City-level insights
city_aqi_summary = data.groupby("City")["AQI"].mean().sort_values()
seasonal_trends = data.groupby(data["Date"].dt.month)["AQI"].mean()

# Step 6: Export results
city_aqi_summary.to_csv("city_aqi_summary.csv")
correlation_matrix.to_csv("correlation_matrix.csv")
seasonal_trends.to_csv("seasonal_trends.csv")

print("✅ Air quality & weather analysis completed successfully!")


import pandas as pd

# Step 1: Load data
patients = pd.read_csv("patients.csv")
admissions = pd.read_csv("admissions.csv")
treatments = pd.read_csv("treatments.csv")
billing = pd.read_csv("billing.csv")

# Step 2: Clean data
admissions["AdmissionDate"] = pd.to_datetime(admissions["AdmissionDate"])
admissions["DischargeDate"] = pd.to_datetime(admissions["DischargeDate"])
billing["PaymentDate"] = pd.to_datetime(billing["PaymentDate"])

# Step 3: Patient analysis
admissions["LengthOfStay"] = (admissions["DischargeDate"] - admissions["AdmissionDate"]).dt.days
avg_stay_per_dept = admissions.groupby("Department")["LengthOfStay"].mean()

# Step 4: Treatment analysis
treatment_costs = treatments.groupby("AdmissionID")["Cost"].sum()
admissions = admissions.merge(treatment_costs, on="AdmissionID", how="left", suffixes=("", "_Treatment"))

# Step 5: Billing analysis
billing_summary = billing.groupby("AdmissionID").agg({
    "AmountPaid": "sum",
    "PaymentDate": "max"
})
admissions = admissions.merge(billing_summary, on="AdmissionID", how="left")
admissions["Outstanding"] = admissions["Cost"] - admissions["AmountPaid"]

# Step 6: Hospital performance
revenue_per_dept = admissions.groupby("Department")["AmountPaid"].sum()
readmissions = admissions.groupby("PatientID")["AdmissionDate"].diff().dt.days
readmission_rate = (readmissions < 30).sum() / len(admissions)

# Step 7: Export results
admissions.to_csv("patient_summary.csv", index=False)
avg_stay_per_dept.to_csv("department_performance.csv")
billing_summary.to_csv("billing_summary.csv")

print("✅ Hospital analytics completed successfully!")
print(f"Readmission rate: {readmission_rate:.2%}")


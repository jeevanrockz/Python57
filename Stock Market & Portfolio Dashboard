import dash
from dash import dcc, html, Input, Output
import plotly.express as px
import plotly.graph_objects as go
import pandas as pd
import numpy as np

# -----------------------------
# Step 1: Create Synthetic Data
# -----------------------------

companies = ["Company A", "Company B", "Company C"]
dates = pd.date_range(start="2021-01-01", end="2021-01-15")

# Stock prices (OHLC)
stock_data = pd.DataFrame({
    "date": np.tile(dates, len(companies)),
    "company": np.repeat(companies, len(dates)),
    "open": np.random.randint(80, 120, len(dates)*len(companies)),
    "high": np.random.randint(100, 150, len(dates)*len(companies)),
    "low": np.random.randint(70, 100, len(dates)*len(companies)),
    "close": np.random.randint(80, 130, len(dates)*len(companies)),
    "volume": np.random.randint(1000, 5000, len(dates)*len(companies))
})

# Portfolio allocation
portfolio = pd.DataFrame({
    "company": companies,
    "allocation": [40, 35, 25]
})

# Risk vs return
risk_return = pd.DataFrame({
    "company": companies,
    "risk": [0.15, 0.20, 0.10],
    "return": [0.12, 0.18, 0.08]
})

# Market capitalization
market_cap = pd.DataFrame({
    "company": companies,
    "market_cap": [50, 70, 40],
    "performance": [0.10, 0.15, 0.08]
})

# Correlation matrix
corr_matrix = stock_data.pivot(index="date", columns="company", values="close").corr()

# -----------------------------
# Step 2: Initialize Dash App
# -----------------------------
app = dash.Dash(__name__)
app.title = "Stock Market & Portfolio Dashboard"

# -----------------------------
# Step 3: Layout with Tabs
# -----------------------------
app.layout = html.Div([
    html.H1("💹 Stock Market & Portfolio Dashboard", style={"textAlign": "center"}),

    dcc.Tabs([
        dcc.Tab(label="Stock Prices", children=[
            dcc.Dropdown(
                id="company-filter",
                options=[{"label": c, "value": c} for c in companies],
                value="Company A",
                clearable=False
            ),
            dcc.Graph(id="price-line"),
            dcc.Graph(id="candlestick-chart"),
        ]),
        dcc.Tab(label="Trading Volume", children=[
            dcc.Graph(id="volume-bar"),
        ]),
        dcc.Tab(label="Portfolio Allocation", children=[
            dcc.Graph(id="portfolio-pie"),
        ]),
        dcc.Tab(label="Risk & Correlation", children=[
            dcc.Graph(id="risk-return-scatter"),
            dcc.Graph(id="correlation-heatmap"),
            dcc.Graph(id="bubble-chart"),
        ])
    ])
])

# -----------------------------
# Step 4: Callbacks
# -----------------------------

@app.callback(Output("price-line", "figure"), Input("company-filter", "value"))
def update_price_line(company):
    df = stock_data[stock_data["company"] == company]
    fig = px.line(df, x="date", y="close", title=f"Stock Price Trend - {company}")
    return fig

@app.callback(Output("candlestick-chart", "figure"), Input("company-filter", "value"))
def update_candlestick(company):
    df = stock_data[stock_data["company"] == company]
    fig = go.Figure(data=[go.Candlestick(
        x=df["date"],
        open=df["open"],
        high=df["high"],
        low=df["low"],
        close=df["close"]
    )])
    fig.update_layout(title=f"Candlestick Chart - {company}")
    return fig

@app.callback(Output("volume-bar", "figure"), Input("volume-bar", "id"))
def update_volume(_):
    avg_volume = stock_data.groupby("company")["volume"].mean().reset_index()
    fig = px.bar(avg_volume, x="company", y="volume", title="Average Trading Volume")
    return fig

@app.callback(Output("portfolio-pie", "figure"), Input("portfolio-pie", "id"))
def update_portfolio(_):
    fig = px.pie(portfolio, names="company", values="allocation",
                 title="Portfolio Allocation")
    return fig

@app.callback(Output("risk-return-scatter", "figure"), Input("risk-return-scatter", "id"))
def update_risk_return(_):
    fig = px.scatter(risk_return, x="risk", y="return", text="company",
                     size="return", color="company",
                     title="Risk vs Return")
    fig.update_traces(textposition="top center")
    return fig

@app.callback(Output("correlation-heatmap", "figure"), Input("correlation-heatmap", "id"))
def update_heatmap(_):
    fig = px.imshow(corr_matrix, text_auto=True,
                    x=corr_matrix.columns, y=corr_matrix.columns,
                    title="Correlation Between Stock Returns")
    return fig

@app.callback(Output("bubble-chart", "figure"), Input("bubble-chart", "id"))
def update_bubble(_):
    fig = px.scatter(market_cap, x="performance", y="company",
                     size="market_cap", color="company", hover_name="company",
                     title="Market Capitalization vs Performance")
    return fig

# -----------------------------
# Step 5: Run App
# -----------------------------
if __name__ == "__main__":
    app.run(debug=True)

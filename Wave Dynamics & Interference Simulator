import numpy as np
import matplotlib.pyplot as plt

nx, ny, nz = 50, 50, 50
c, dt, dx = 1.0, 0.1, 1.0

u = np.zeros((nx, ny, nz))
u_prev = np.zeros((nx, ny, nz))

# Initial disturbance in the center
u[nx//2, ny//2, nz//2] = 1.0

def laplacian_3d(field):
    return (
        np.roll(field, 1, axis=0) + np.roll(field, -1, axis=0) +
        np.roll(field, 1, axis=1) + np.roll(field, -1, axis=1) +
        np.roll(field, 1, axis=2) + np.roll(field, -1, axis=2) -
        6 * field
    ) / (dx**2)

def update_wave_3d(u, u_prev):
    return 2*u - u_prev + (c**2 * dt**2) * laplacian_3d(u)

# Run a few steps and visualize slices
for step in range(50):
    u_next = update_wave_3d(u, u_prev)
    u_prev, u = u, u_next

plt.imshow(u[:,:,nz//2], cmap='viridis')
plt.title("3D Wave Slice (Z mid-plane)")
plt.show()


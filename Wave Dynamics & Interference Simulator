import numpy as np

def laplacian(field, dx, dy):
    return (
        np.roll(field, 1, axis=0) + np.roll(field, -1, axis=0) +
        np.roll(field, 1, axis=1) + np.roll(field, -1, axis=1) -
        4 * field
    ) / (dx * dy)

def update_wave(u, u_prev, c, dt, dx, dy):
    return 2*u - u_prev + (c**2 * dt**2) * laplacian(u, dx, dy)

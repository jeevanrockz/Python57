import numpy as np
import matplotlib.pyplot as plt
import matplotlib.animation as animation

# -----------------------------
# Step 1: Grid Setup
# -----------------------------
nx, ny = 200, 200   # grid size
c = 1.0             # wave speed
dt = 0.1            # time step
dx = 1.0            # spatial step
dy = 1.0

# Courant condition for stability
assert c * dt / dx < 1, "Simulation unstable: adjust dt or dx"

# Initialize wave fields
u = np.zeros((nx, ny))       # current state
u_prev = np.zeros((nx, ny))  # previous state
u_next = np.zeros((nx, ny))  # next state

# Initial disturbance in the center
u[nx//2, ny//2] = 1.0

# -----------------------------
# Step 2: Laplacian Function
# -----------------------------
def laplacian(field):
    return (
        np.roll(field, 1, axis=0) + np.roll(field, -1, axis=0) +
        np.roll(field, 1, axis=1) + np.roll(field, -1, axis=1) -
        4 * field
    ) / (dx * dy)

# -----------------------------
# Step 3: Update Function
# -----------------------------
def update_wave(u, u_prev):
    return 2*u - u_prev + (c**2 * dt**2) * laplacian(u)

# -----------------------------
# Step 4: Simulation Loop
# -----------------------------
frames = 200
snapshots = []

for _ in range(frames):
    u_next = update_wave(u, u_prev)
    
    # Boundary conditions (absorbing)
    u_next[0,:] = u_next[-1,:] = 0
    u_next[:,0] = u_next[:,-1] = 0
    
    # Update states
    u_prev, u = u, u_next
    snapshots.append(u.copy())

# -----------------------------
# Step 5: Visualization
# -----------------------------
fig, ax = plt.subplots()
im = ax.imshow(snapshots[0], cmap='viridis', animated=True)

def animate(i):
    im.set_array(snapshots[i])
    return [im]

ani = animation.FuncAnimation(fig, animate, frames=frames, interval=50, blit=True)
plt.title("Wave Propagation Simulation")
plt.show()


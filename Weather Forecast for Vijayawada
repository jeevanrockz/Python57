        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: {{ times|tojson }},
                datasets: [{
                    label: 'Temperature (°C)',
                    data: {{ temps|tojson }},
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    fill: true,
                    tension: 0.3
                }]

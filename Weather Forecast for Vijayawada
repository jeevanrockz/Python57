import requests
from flask import Flask, render_template

app = Flask(__name__)

API_KEY = "f4f197a34369c843aee80e892d5ac384"  # Replace with your API key
CITY = "Vijayawada"
URL = f"http://api.openweathermap.org/data/2.5/forecast?q={CITY}&appid={API_KEY}&units=metric"

@app.route("/")
def index():
    response = requests.get(URL)
    data = response.json()

    # Extract temperature and time
    temps = [item["main"]["temp"] for item in data["list"][:8]]  # next 8 time slots
    times = [item["dt_txt"].split(" ")[1][:5] for item in data["list"][:8]]

    return render_template("weather.html", city=CITY, temps=temps, times=times)

if __name__ == "__main__":
    app.run(debug=True)


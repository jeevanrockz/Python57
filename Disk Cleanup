    if choice == '1':
        print("\nStarting full disk analysis...")
        cleanup.scan_large_files(min_size_mb=100, max_depth=5)
        cleanup.scan_duplicate_files(max_depth=5)
        cleanup.scan_temporary_files(max_age_days=30, max_depth=5)
        
        cleanup.display_large_files(top_n=20)
        cleanup.display_duplicate_files()
        cleanup.display_temporary_files(top_n=20)
        cleanup.display_cleanup_recommendations()
        cleanup.save_report()
    
    elif choice == '2':
        min_size = input("Enter minimum file size in MB (default 100): ").strip()
        min_size = int(min_size) if min_size.isdigit() else 100
        
        cleanup.scan_large_files(min_size_mb=min_size, max_depth=5)

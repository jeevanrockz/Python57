                'total_savings_human': self.get_file_size(self.total_duplicate_size),
            },
            'temporary_files': {
                'count': len(self.temp_files),
                'total_size': self.total_temp_size,
                'total_size_human': self.get_file_size(self.total_temp_size),
                'files': self.temp_files[:50]  # Top 50

        ],
        'Linux': [
            '/tmp',
            '/var/tmp',
            '/var/cache',
            '~/.cache',
            '~/.local/share/Trash',
        ],
        'macOS': [
            '/Library/Caches',
            '/var/tmp',
            '/var/cache',
            '~/.cache',
            '~/.Trash',
        ]
    }
    
    # Temporary file patterns
    TEMP_FILE_PATTERNS = {

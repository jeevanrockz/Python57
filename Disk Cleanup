        except Exception as e:
            print(f"Error saving report: {e}")
    
    def cleanup_confirmed(self, files_to_delete: List[str], dry_run: bool = True):
        """
        Delete confirmed files.
        
        Args:
            files_to_delete: List of file paths to delete
            dry_run: If True, show what would be deleted without actually deleting
        """
        successful = 0
        failed = 0
        total_freed = 0
        
        for filepath in files_to_delete:
            try:
                file_path = Path(filepath)
                
                if dry_run:
                    size = file_path.stat().st_size
                    print(f"Would delete: {filepath} ({self.get_file_size(size)})")
                    total_freed += size
                else:
                    size = file_path.stat().st_size
                    file_path.unlink()
                    print(f"Deleted: {filepath}")
                    successful += 1
                    total_freed += size
            
            except (OSError, PermissionError) as e:
                print(f"Failed to delete {filepath}: {e}")
                failed += 1
        
        print(f"\nResults: {successful} deleted, {failed} failed")
        print(f"Space freed: {self.get_file_size(total_freed)}")


def main():
    """Main entry point"""
    cleanup = DiskCleanupUtility()
    
    print("\nDisk Cleanup Utility - Choose option:")
    print("1. Full disk analysis")
    print("2. Scan for large files only")
    print("3. Scan for duplicates only")
    print("4. Scan for temporary files only")
    print("5. View cleanup recommendations")
    print("6. Exit")
    

    elif choice == '3':
        cleanup.scan_duplicate_files(compare_size_only=False, max_depth=5)
        cleanup.display_duplicate_files()
    
    elif choice == '4':
        max_age = input("Enter max age in days (default 30): ").strip()
        max_age = int(max_age) if max_age.isdigit() else 30
        
        cleanup.scan_temporary_files(max_age_days=max_age, max_depth=5)
        cleanup.display_temporary_files(top_n=50)
    
    elif choice == '5':
        print("\nRunning quick analysis...")
        cleanup.scan_large_files(min_size_mb=100, max_depth=5)
        cleanup.scan_duplicate_files(max_depth=5)
        cleanup.scan_temporary_files(max_age_days=30, max_depth=5)
        cleanup.display_cleanup_recommendations()
    
    elif choice == '6':
        print("Exiting...")
    
    else:
        print("Invalid choice!")


if __name__ == "__main__":
    main()

    def __init__(self, root_path: str = None):
        """
        Initialize the disk cleanup utility.
        
        Args:
            root_path: Root directory to scan (default: user home directory)
        """
        self.root_path = Path(root_path) if root_path else Path.home()
        self.large_files = []
        self.duplicate_files = {}
        self.temp_files = []
        self.total_large_size = 0
        self.total_duplicate_size = 0
        self.total_temp_size = 0
    
    def get_file_size(self, size_bytes: int) -> str:
        """Convert bytes to human readable format"""
        for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
            if size_bytes < 1024.0:
                return f"{size_bytes:.2f} {unit}"
            size_bytes /= 1024.0
        return f"{size_bytes:.2f} PB"
    
    def calculate_file_hash(self, filepath: Path, block_size: int = 65536) -> Optional[str]:
        """Calculate MD5 hash of a file"""
        try:
            hasher = hashlib.md5()
            with open(filepath, 'rb') as f:
                while True:
                    block = f.read(block_size)
                    if not block:
                        break
                    hasher.update(block)
            return hasher.hexdigest()
        except (IOError, OSError, PermissionError):
            return None
    
    def scan_large_files(self, min_size_mb: int = 100, max_depth: int = 5) -> List[Dict]:
        """
        Scan for large files.
        
        Args:
            min_size_mb: Minimum file size in MB to consider
            max_depth: Maximum directory depth to scan
        
        Returns:
            List of large files with details
        """
        min_bytes = min_size_mb * (1024 * 1024)
        large_files = []
        
        print(f"Scanning for files larger than {min_size_mb}MB...", end='', flush=True)
        
        try:
            for root, dirs, files in os.walk(self.root_path):
                # Limit depth
                depth = len(Path(root).relative_to(self.root_path).parts)
                if depth > max_depth:
                    dirs[:] = []
                    continue
                
                # Skip certain directories
                dirs[:] = [d for d in dirs if not d.startswith('.')]
                
                for file in files:
                    try:
                        filepath = Path(root) / file
                        size = filepath.stat().st_size
                        
                        if size > min_bytes:
                            stat = filepath.stat()
                            large_files.append({
                                'path': str(filepath),
                                'name': file,
                                'size': size,
                                'size_human': self.get_file_size(size),
                                'modified': datetime.fromtimestamp(stat.st_mtime).strftime('%Y-%m-%d %H:%M:%S'),
                                'created': datetime.fromtimestamp(stat.st_ctime).strftime('%Y-%m-%d %H:%M:%S'),
                            })
                    except (OSError, PermissionError):
                        pass
        
        except PermissionError:
            pass
        
        # Sort by size
        large_files.sort(key=lambda x: x['size'], reverse=True)
        self.large_files = large_files
        self.total_large_size = sum(f['size'] for f in large_files)
        
        print(f" Found {len(large_files)}")
        return large_files
    
    def scan_duplicate_files(self, compare_size_only: bool = False, max_depth: int = 5) -> Dict:
        """
        Scan for duplicate files.
        
        Args:
            compare_size_only: If True, only compare by size (faster)
            max_depth: Maximum directory depth to scan
        
        Returns:
            Dictionary of duplicate files
        """
        print("Scanning for duplicate files...", end='', flush=True)
        
        files_by_size = defaultdict(list)
        duplicates = defaultdict(list)
        
        try:
            for root, dirs, files in os.walk(self.root_path):
                # Limit depth
                depth = len(Path(root).relative_to(self.root_path).parts)
                if depth > max_depth:
                    dirs[:] = []
                    continue
                
                dirs[:] = [d for d in dirs if not d.startswith('.')]
                
                for file in files:
                    try:
                        filepath = Path(root) / file
                        size = filepath.stat().st_size
                        
                        # Only check files larger than 1MB
                        if size > 1024 * 1024:
                            files_by_size[size].append(filepath)
                    except (OSError, PermissionError):
                        pass
        
        except PermissionError:
            pass
        
        # Find duplicates
        total_duplicate_count = 0
        for size, paths in files_by_size.items():
            if len(paths) > 1:
                if compare_size_only:
                    # Just group by size
                    duplicates[size] = [str(p) for p in paths]
                    total_duplicate_count += len(paths) - 1
                else:
                    # Compare by hash for accuracy
                    by_hash = defaultdict(list)
                    for path in paths:
                        file_hash = self.calculate_file_hash(path)
                        if file_hash:
                            by_hash[file_hash].append(str(path))
                    
                    for file_hash, dupes in by_hash.items():
                        if len(dupes) > 1:
                            duplicates[file_hash] = {
                                'size': size,
                                'size_human': self.get_file_size(size),
                                'files': dupes,
                                'count': len(dupes),
                                'savings': self.get_file_size(size * (len(dupes) - 1))
                            }
                            total_duplicate_count += len(dupes) - 1
                            self.total_duplicate_size += size * (len(dupes) - 1)
        
        self.duplicate_files = duplicates
        print(f" Found {total_duplicate_count} duplicate files")
        return duplicates
    
    def scan_temporary_files(self, max_age_days: int = 30, max_depth: int = 5) -> List[Dict]:
        """
        Scan for temporary and unused files.
        
        Args:
            max_age_days: Consider files older than this as unused
            max_depth: Maximum directory depth to scan
        
        Returns:
            List of temporary files
        """
        print("Scanning for temporary files...", end='', flush=True)
        
        temp_files = []
        cutoff_date = datetime.now() - timedelta(days=max_age_days)
        cutoff_timestamp = cutoff_date.timestamp()
        
        # Common temp locations
        temp_paths = [
            Path.home() / 'AppData' / 'Local' / 'Temp',
            Path.home() / 'AppData' / 'Local' / 'Cache',
            Path.home() / '.cache',
            Path.home() / '.local' / 'share' / 'Trash',
            Path('/tmp') if Path('/tmp').exists() else None,
            Path('/var/tmp') if Path('/var/tmp').exists() else None,
        ]
        
        for temp_path in temp_paths:
            if temp_path is None or not temp_path.exists():
                continue
            
            try:
                for root, dirs, files in os.walk(temp_path):
                    depth = len(Path(root).relative_to(temp_path).parts)
                    if depth > max_depth:
                        dirs[:] = []
                        continue
                    
                    for file in files:
                        try:
                            filepath = Path(root) / file
                            stat = filepath.stat()
                            
                            # Check if file is old
                            if stat.st_mtime < cutoff_timestamp or stat.st_size < 10 * 1024 * 1024:
                                temp_files.append({
                                    'path': str(filepath),
                                    'name': file,
                                    'size': stat.st_size,
                                    'size_human': self.get_file_size(stat.st_size),
                                    'modified': datetime.fromtimestamp(stat.st_mtime).strftime('%Y-%m-%d'),
                                    'age_days': int((datetime.now() - datetime.fromtimestamp(stat.st_mtime)).days),
                                })
                                self.total_temp_size += stat.st_size
                        except (OSError, PermissionError):
                            pass
            
            except (OSError, PermissionError):
                pass
        
        # Sort by size
        temp_files.sort(key=lambda x: x['size'], reverse=True)
        self.temp_files = temp_files
        
        print(f" Found {len(temp_files)}")
        return temp_files
    

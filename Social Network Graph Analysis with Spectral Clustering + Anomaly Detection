# -----------------------------
# 1. Import Libraries
# -----------------------------
import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import SpectralClustering
from sklearn.decomposition import PCA
from sklearn.ensemble import IsolationForest

# -----------------------------
# 2. Generate Synthetic Graph
# -----------------------------
np.random.seed(42)
n_nodes = 50

# Create adjacency matrix (random friendships)
adj_matrix = np.random.randint(0, 2, size=(n_nodes, n_nodes))
np.fill_diagonal(adj_matrix, 0)  # no self-loops
adj_matrix = np.triu(adj_matrix) + np.triu(adj_matrix, 1).T  # symmetric

# Feature: degree of each node (number of connections)
degrees = adj_matrix.sum(axis=1).reshape(-1,1)

# -----------------------------
# 3. Spectral Clustering
# -----------------------------
spectral = SpectralClustering(n_clusters=3, affinity="precomputed", random_state=42)
labels = spectral.fit_predict(adj_matrix)

# -----------------------------
# 4. Anomaly Detection
# -----------------------------
iso = IsolationForest(contamination=0.1, random_state=42)
anomalies = iso.fit_predict(degrees)  # -1 = anomaly, 1 = normal

# -----------------------------
# 5. Visualization
# -----------------------------
pca = PCA(n_components=2)
X_pca = pca.fit_transform(adj_matrix)

plt.figure(figsize=(8,6))
for i in range(n_nodes):
    if anomalies[i] == -1:
        plt.scatter(X_pca[i,0], X_pca[i,1], c="red", marker="x", s=100, label="Anomaly" if i==0 else "")
    else:
        plt.scatter(X_pca[i,0], X_pca[i,1], c=f"C{labels[i]}", s=50)
plt.title("Spectral Clustering + Anomaly Detection in Social Network")
plt.xlabel("PCA Component 1")
plt.ylabel("PCA Component 2")
plt.legend()
plt.show()

print("Cluster labels:", labels)
print("Anomalies detected (node indices):", np.where(anomalies == -1)[0])

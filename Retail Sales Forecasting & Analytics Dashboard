import matplotlib.pyplot as plt
import numpy as np

# Simulated historical sales data
months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
sales = [12000, 13500, 15000, 14500, 16000, 17500, 
         19000, 20000, 19500, 21000, 22000, 23000]

# Forecast next 6 months using linear trend
forecast_months = ["Jan_F","Feb_F","Mar_F","Apr_F","May_F","Jun_F"]
x = np.arange(len(sales))
coeffs = np.polyfit(x, sales, 1)  # linear fit
forecast_x = np.arange(len(sales), len(sales)+6)
forecast_sales = np.polyval(coeffs, forecast_x)

# Product category sales
categories = ["Electronics", "Fashion", "Home", "Books", "Sports"]
category_sales = [40000, 30000, 20000, 15000, 10000]

# Regional sales distribution
regions = ["North", "South", "East", "West"]
region_share = [35, 25, 20, 20]

# Customer purchase frequency
np.random.seed(42)
purchase_frequency = np.random.randint(1, 20, 300)

# Price variation across categories
price_categories = ["Electronics", "Fashion", "Home", "Books", "Sports"]
price_data = [np.random.normal(500, 50, 100),
              np.random.normal(150, 20, 100),
              np.random.normal(300, 40, 100),
              np.random.normal(100, 15, 100),
              np.random.normal(250, 30, 100)]

# Create dashboard with 2x3 subplots
fig, axs = plt.subplots(2, 3, figsize=(18,10))

# 1. Line chart: Historical sales
axs[0,0].plot(months, sales, marker='o', color='blue', linewidth=2)
axs[0,0].set_title("Historical Monthly Sales")
axs[0,0].set_xlabel("Months")
axs[0,0].set_ylabel("Sales ($)")
axs[0,0].grid(True, linestyle='--', alpha=0.7)

# 2. Forecast line chart
axs[0,1].plot(months, sales, marker='o', color='blue', label="Historical")
axs[0,1].plot(forecast_months, forecast_sales, marker='o', color='red', linestyle='--', label="Forecast")
axs[0,1].set_title("Sales Forecast (Next 6 Months)")
axs[0,1].set_xlabel("Months")
axs[0,1].set_ylabel("Sales ($)")
axs[0,1].legend()
axs[0,1].grid(True, linestyle='--', alpha=0.7)

# 3. Bar chart: Product category sales
axs[0,2].bar(categories, category_sales, color=['#ff9999','#66b3ff','#99ff99','#ffcc99','#c2c2f0'])
axs[0,2].set_title("Product Category Sales")
axs[0,2].set_xlabel("Categories")
axs[0,2].set_ylabel("Sales ($)")
axs[0,2].grid(axis='y', linestyle='--', alpha=0.7)

# 4. Pie chart: Regional sales distribution
explode = [0.1 if share == max(region_share) else 0 for share in region_share]
axs[1,0].pie(region_share, labels=regions, autopct="%1.1f%%", 
             startangle=140, explode=explode, shadow=True, 
             colors=["#ff9999","#66b3ff","#99ff99","#ffcc99"])
axs[1,0].set_title("Regional Sales Distribution")

# 5. Histogram: Customer purchase frequency
axs[1,1].hist(purchase_frequency, bins=15, color="skyblue", edgecolor="black")
axs[1,1].set_title("Customer Purchase Frequency")
axs[1,1].set_xlabel("Purchases per Customer")
axs[1,1].set_ylabel("Number of Customers")
axs[1,1].grid(axis='y', linestyle='--', alpha=0.7)

# 6. Box plot: Price variation across categories
axs[1,2].boxplot(price_data, tick_labels=price_categories)
axs[1,2].set_title("Price Variation by Category")
axs[1,2].set_ylabel("Price ($)")

# Adjust layout
plt.tight_layout()
plt.suptitle("Retail Sales Forecasting & Analytics Dashboard", fontsize=18, y=1.05)

# Show dashboard
plt.show()

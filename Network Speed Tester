#!/usr/bin/env python3
"""
Network Speed Tester - Measure upload/download speed and log results over time
Provides detailed network diagnostics and historical speed tracking
"""

import os
import sys
import csv
import json
import time
import socket
import threading
from datetime import datetime, timedelta
from pathlib import Path
from typing import Dict, List, Optional, Tuple
from statistics import mean, median, stdev

try:
    import psutil
except ImportError:
    psutil = None


class NetworkSpeedTester:
    """Test and monitor network speed"""
    
    def __init__(self, log_file: str = 'network_speed_logs.csv', report_file: str = 'speed_report.json'):
        """
        Initialize the network speed tester.
        
        Args:
            log_file: CSV file to store historical logs
            report_file: JSON file to store speed reports
        """
        self.log_file = log_file
        self.report_file = report_file
        self.speed_history = []
        self.current_speed = None
        self.load_history()
    
    def check_internet_connection(self) -> bool:
        """Check if internet connection is available"""
        try:
            socket.create_connection(("8.8.8.8", 53), timeout=3)
            return True
        except (socket.timeout, socket.error):
            return False
    
    def get_local_ip(self) -> Optional[str]:
        """Get local IP address"""
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("8.8.8.8", 80))
            ip = s.getsockname()[0]
            s.close()
            return ip
        except Exception:
            return None
    
    def test_download_speed(self, file_size_mb: int = 10) -> Optional[Dict]:
        """
        Test download speed by downloading a test file.
        
        Args:
            file_size_mb: Size of test file in MB
            
        Returns:
            Dictionary with speed results
        """
        try:
            import urllib.request
            
            # Use a fast CDN for testing
            test_urls = [
                'https://speed.cloudflare.com/__down?bytes=1000000',
                'https://www.google.com/images/branding/googlelogo/1x/googlelogo_color_272x92dp.png',
            ]
            
            for url in test_urls:
                try:
                    start_time = time.time()
                    
                    with urllib.request.urlopen(url, timeout=10) as response:
                        data = response.read(file_size_mb * 1024 * 1024)
                    
                    elapsed = time.time() - start_time
                    
                    if elapsed > 0:
                        bytes_downloaded = len(data)
                        speed_mbps = (bytes_downloaded * 8) / (elapsed * 1000000)
                        
                        return {
                            'speed_mbps': speed_mbps,
                            'bytes_transferred': bytes_downloaded,
                            'time_seconds': elapsed,
                            'success': True
                        }
                except Exception:
                    continue
            
            return {'success': False, 'error': 'Download test failed'}
        
        except Exception as e:
            return {'success': False, 'error': str(e)}
    
    def test_upload_speed(self) -> Optional[Dict]:
        """
        Simulate upload speed test using threading-based loopback.
        
        Note: Actual upload testing would require server-side support.
        This provides an estimate based on local network performance.
        """
        try:
            # Test local network performance as proxy for upload
            test_data_size = 10 * 1024 * 1024  # 10 MB
            test_data = os.urandom(test_data_size)
            
            # Use a threaded approach for upload simulation
            from io import BytesIO
            
            bytes_transferred = 0
            lock = threading.Lock()
            
            def receiver(data, received_bytes):
                """Simulate receiving data"""
                nonlocal bytes_transferred
                with lock:
                    bytes_transferred += len(data)
            
            start_time = time.time()
            
            # Send data in chunks
            chunk_size = 1024 * 1024  # 1 MB chunks
            threads = []
            
            for i in range(0, len(test_data), chunk_size):
                chunk = test_data[i:i+chunk_size]
                t = threading.Thread(target=receiver, args=(chunk, 0))
                t.start()
                threads.append(t)
            
            # Wait for all threads to complete
            for t in threads:
                t.join()
            
            elapsed = time.time() - start_time
            
            if elapsed > 0:
                speed_mbps = (bytes_transferred * 8) / (elapsed * 1000000)
                
                return {
                    'speed_mbps': speed_mbps,
                    'bytes_transferred': bytes_transferred,
                    'time_seconds': elapsed,
                    'success': True,
                    'note': 'Local loopback test (network estimate)'
                }
            
            return {'success': False, 'error': 'Upload test failed'}
        
        except Exception as e:
            return {'success': False, 'error': str(e)}
    
    def test_ping(self, host: str = '8.8.8.8') -> Optional[float]:
        """
        Test latency (ping) to a host.
        
        Args:
            host: Host to ping
            
        Returns:
            Latency in milliseconds
        """
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(5)
            
            start_time = time.time()
            sock.connect((host, 80))
            elapsed = (time.time() - start_time) * 1000  # Convert to ms
            
            sock.close()
            
            return elapsed
        except Exception:
            return None
    
    def perform_speed_test(self, verbose: bool = True) -> Dict:
        """
        Perform complete network speed test.
        
        Args:
            verbose: Print progress messages
            
        Returns:
            Dictionary with all test results
        """
        results = {
            'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'internet_connected': False,
            'local_ip': None,
            'download_speed': None,
            'upload_speed': None,
            'ping_latency': None
        }
        
        # Check internet
        if verbose:
            print("Checking internet connection...", end='', flush=True)
        
        if not self.check_internet_connection():
            if verbose:
                print(" ✗ No internet connection")
            return results
        
        if verbose:
            print(" ✓")
        
        results['internet_connected'] = True
        results['local_ip'] = self.get_local_ip()
        
        # Test ping
        if verbose:
            print("Testing latency (ping)...", end='', flush=True)
        ping = self.test_ping()
        if ping:
            results['ping_latency'] = ping
            if verbose:
                print(f" {ping:.2f}ms")
        else:
            if verbose:
                print(" ✗")
        
        # Test download
        if verbose:
            print("Testing download speed...", end='', flush=True)
        download = self.test_download_speed()
        if download and download.get('success'):
            results['download_speed'] = download['speed_mbps']
            if verbose:
                print(f" {download['speed_mbps']:.2f} Mbps")
        else:
            if verbose:
                print(" ✗")
        
        # Test upload
        if verbose:
            print("Testing upload speed...", end='', flush=True)
        upload = self.test_upload_speed()
        if upload and upload.get('success'):
            results['upload_speed'] = upload['speed_mbps']
            if verbose:
                print(f" {upload['speed_mbps']:.2f} Mbps")
        else:
            if verbose:
                print(" ✗")
        
        self.current_speed = results
        self.speed_history.append(results)
        self.log_results(results)
        
        return results
    
    def log_results(self, results: Dict):
        """Log test results to CSV file"""
        file_exists = os.path.exists(self.log_file)
        
        try:
            with open(self.log_file, 'a', newline='') as f:
                writer = csv.writer(f)
                
                if not file_exists:
                    writer.writerow([
                        'Timestamp',
                        'Download Mbps',
                        'Upload Mbps',
                        'Ping ms',
                        'Local IP',
                        'Connected'
                    ])
                
                writer.writerow([
                    results['timestamp'],
                    f"{results['download_speed']:.2f}" if results['download_speed'] else 'N/A',
                    f"{results['upload_speed']:.2f}" if results['upload_speed'] else 'N/A',
                    f"{results['ping_latency']:.2f}" if results['ping_latency'] else 'N/A',
                    results['local_ip'] or 'N/A',
                    'Yes' if results['internet_connected'] else 'No'
                ])
        except Exception as e:
            print(f"Error logging results: {e}")
    
    def load_history(self):
        """Load speed history from CSV file"""
        if not os.path.exists(self.log_file):
            return
        
        try:
            with open(self.log_file, 'r') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    self.speed_history.append({
                        'timestamp': row['Timestamp'],
                        'download_speed': float(row['Download Mbps']) if row['Download Mbps'] != 'N/A' else None,
                        'upload_speed': float(row['Upload Mbps']) if row['Upload Mbps'] != 'N/A' else None,
                        'ping_latency': float(row['Ping ms']) if row['Ping ms'] != 'N/A' else None,
                        'local_ip': row['Local IP'],
                        'internet_connected': row['Connected'] == 'Yes'
                    })
        except Exception as e:
            print(f"Error loading history: {e}")
    
    def display_current_results(self):
        """Display current test results"""
        if not self.current_speed:
            print("No test results available. Run a speed test first.")
            return
        
        results = self.current_speed
        
        print(f"\n{'='*80}")
        print(f" NETWORK SPEED TEST RESULTS ".center(80, "="))
        print(f"{'='*80}\n")
        
        print(f"Timestamp: {results['timestamp']}")
        print(f"Internet Connection: {'✓ Connected' if results['internet_connected'] else '✗ Disconnected'}")
        print(f"Local IP: {results['local_ip'] or 'N/A'}")
        print()
        
        # Speed indicators
        if results['download_speed']:
            speed = results['download_speed']
            status = self.get_speed_quality(speed, 'download')
            print(f"Download Speed: {speed:>8.2f} Mbps {status}")
        else:
            print("Download Speed: N/A")
        
        if results['upload_speed']:
            speed = results['upload_speed']
            status = self.get_speed_quality(speed, 'upload')
            print(f"Upload Speed:   {speed:>8.2f} Mbps {status}")
        else:
            print("Upload Speed:   N/A")
        
        if results['ping_latency']:
            latency = results['ping_latency']
            status = self.get_latency_quality(latency)
            print(f"Latency (Ping): {latency:>8.2f} ms  {status}")
        else:
            print("Latency (Ping): N/A")
        
        print("\n" + "="*80 + "\n")
    
    def display_speed_history(self, last_n: int = 10):
        """Display historical speed test results"""
        if not self.speed_history:
            print("No speed history available.")
            return
        
        print(f"\n{'='*100}")
        print(f" SPEED TEST HISTORY (Last {last_n}) ".center(100, "="))
        print(f"{'='*100}\n")
        
        print(f"{'Timestamp':<20} {'Download':<15} {'Upload':<15} {'Ping':<12} {'Connected':<12}")
        print("-" * 100)
        
        for result in self.speed_history[-last_n:]:
            download = f"{result['download_speed']:.2f} Mbps" if result['download_speed'] else "N/A"
            upload = f"{result['upload_speed']:.2f} Mbps" if result['upload_speed'] else "N/A"
            ping = f"{result['ping_latency']:.2f} ms" if result['ping_latency'] else "N/A"
            connected = "✓ Yes" if result['internet_connected'] else "✗ No"
            
            print(f"{result['timestamp']:<20} {download:<15} {upload:<15} {ping:<12} {connected:<12}")
        
        print("\n" + "="*100 + "\n")
    
    def display_statistics(self):
        """Display speed statistics"""
        if not self.speed_history:
            print("No speed data available.")
            return
        
        # Filter valid speeds
        downloads = [r['download_speed'] for r in self.speed_history if r['download_speed']]
        uploads = [r['upload_speed'] for r in self.speed_history if r['upload_speed']]
        pings = [r['ping_latency'] for r in self.speed_history if r['ping_latency']]
        
        print(f"\n{'='*80}")
        print(f" SPEED STATISTICS ".center(80, "="))
        print(f"{'='*80}\n")
        
        print(f"Total tests: {len(self.speed_history)}")
        print(f"Connected: {sum(1 for r in self.speed_history if r['internet_connected'])}")
        print()
        
        if downloads:
            print("DOWNLOAD SPEED:")
            print(f"  Current:  {downloads[-1]:>8.2f} Mbps")
            print(f"  Average:  {mean(downloads):>8.2f} Mbps")
            print(f"  Median:   {median(downloads):>8.2f} Mbps")
            print(f"  Max:      {max(downloads):>8.2f} Mbps")
            print(f"  Min:      {min(downloads):>8.2f} Mbps")
            if len(downloads) > 1:
                print(f"  StdDev:   {stdev(downloads):>8.2f} Mbps")
            print()
        
        if uploads:
            print("UPLOAD SPEED:")
            print(f"  Current:  {uploads[-1]:>8.2f} Mbps")
            print(f"  Average:  {mean(uploads):>8.2f} Mbps")
            print(f"  Median:   {median(uploads):>8.2f} Mbps")
            print(f"  Max:      {max(uploads):>8.2f} Mbps")
            print(f"  Min:      {min(uploads):>8.2f} Mbps")
            if len(uploads) > 1:
                print(f"  StdDev:   {stdev(uploads):>8.2f} Mbps")
            print()
        
        if pings:
            print("LATENCY (PING):")
            print(f"  Current:  {pings[-1]:>8.2f} ms")
            print(f"  Average:  {mean(pings):>8.2f} ms")
            print(f"  Median:   {median(pings):>8.2f} ms")
            print(f"  Max:      {max(pings):>8.2f} ms")
            print(f"  Min:      {min(pings):>8.2f} ms")
            if len(pings) > 1:
                print(f"  StdDev:   {stdev(pings):>8.2f} ms")
        
        print("\n" + "="*80 + "\n")
    
    @staticmethod
    def get_speed_quality(speed_mbps: float, direction: str) -> str:
        """Get quality indicator for speed"""
        if direction == 'download':
            if speed_mbps >= 100:
                return "🟢 Excellent"
            elif speed_mbps >= 50:
                return "🟢 Very Good"
            elif speed_mbps >= 25:
                return "🟡 Good"
            elif speed_mbps >= 10:
                return "🟡 Fair"
            else:
                return "🔴 Poor"
        else:  # upload
            if speed_mbps >= 50:
                return "🟢 Excellent"
            elif speed_mbps >= 20:
                return "🟢 Very Good"
            elif speed_mbps >= 10:
                return "🟡 Good"
            elif speed_mbps >= 5:
                return "🟡 Fair"
            else:
                return "🔴 Poor"
    
    @staticmethod
    def get_latency_quality(latency_ms: float) -> str:
        """Get quality indicator for latency"""
        if latency_ms < 20:
            return "🟢 Excellent"
        elif latency_ms < 50:
            return "🟢 Very Good"
        elif latency_ms < 100:
            return "🟡 Good"
        elif latency_ms < 150:
            return "🟡 Fair"
        else:
            return "🔴 Poor"
    
    def start_continuous_testing(self, interval_minutes: int = 60):
        """
        Start continuous testing at regular intervals.
        
        Args:
            interval_minutes: Minutes between tests
        """
        print(f"\nContinuous speed testing started (every {interval_minutes} minutes)")
        print("Press Ctrl+C to stop\n")
        
        try:
            while True:
                print(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] Running speed test...")
                self.perform_speed_test()
                self.display_current_results()
                
                print(f"Next test in {interval_minutes} minutes...")
                time.sleep(interval_minutes * 60)
        
        except KeyboardInterrupt:
            print("\n\nContinuous testing stopped.")
            self.save_report()
    
    def save_report(self, filename: str = None):
        """Save speed test report to JSON file"""
        if filename is None:
            filename = self.report_file
        
        if not self.speed_history:
            print("No data to save.")
            return
        
        downloads = [r['download_speed'] for r in self.speed_history if r['download_speed']]
        uploads = [r['upload_speed'] for r in self.speed_history if r['upload_speed']]
        pings = [r['ping_latency'] for r in self.speed_history if r['ping_latency']]
        
        report = {
            'generated': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'total_tests': len(self.speed_history),
            'summary': {
                'download': {
                    'average': mean(downloads) if downloads else None,
                    'max': max(downloads) if downloads else None,
                    'min': min(downloads) if downloads else None,
                } if downloads else None,
                'upload': {
                    'average': mean(uploads) if uploads else None,
                    'max': max(uploads) if uploads else None,
                    'min': min(uploads) if uploads else None,
                } if uploads else None,
                'ping': {
                    'average': mean(pings) if pings else None,
                    'max': max(pings) if pings else None,
                    'min': min(pings) if pings else None,
                } if pings else None,
            },
            'history': self.speed_history
        }
        
        try:
            with open(filename, 'w') as f:
                json.dump(report, f, indent=2)
            print(f"\nReport saved to: {filename}")
        except Exception as e:
            print(f"Error saving report: {e}")


def main():
    """Main entry point"""
    tester = NetworkSpeedTester()
    
    print("\nNetwork Speed Tester - Choose option:")
    print("1. Run speed test now")
    print("2. View current results")
    print("3. View speed history")
    print("4. View statistics")
    print("5. Start continuous testing")
    print("6. Save report")
    print("7. Exit")
    
    choice = input("\nEnter your choice (1-7): ").strip()
    
    if choice == '1':
        print()
        tester.perform_speed_test(verbose=True)
        tester.display_current_results()
    
    elif choice == '2':
        tester.display_current_results()
    
    elif choice == '3':
        last_n = input("How many results to show? (default 10): ").strip()
        last_n = int(last_n) if last_n.isdigit() else 10
        tester.display_speed_history(last_n=last_n)
    
    elif choice == '4':
        tester.display_statistics()
    
    elif choice == '5':
        interval = input("Enter interval in minutes (default 60): ").strip()
        interval = int(interval) if interval.isdigit() else 60
        tester.start_continuous_testing(interval_minutes=interval)
    
    elif choice == '6':
        tester.save_report()
    
    elif choice == '7':
        print("Exiting...")
    
    else:
        print("Invalid choice!")


if __name__ == "__main__":
    main()

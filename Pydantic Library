from pydantic import BaseModel, Field, field_validator
from typing import List

# Nested model for Address
class Address(BaseModel):
    city: str
    zip: str = Field(min_length=5, max_length=6, description="Zip code must be 5-6 digits")

# Main model for Student
class Student(BaseModel):
    id: int
    name: str = Field(min_length=3, description="Name must be at least 3 characters")
    age: int = Field(gt=0, lt=120, description="Age must be realistic")
    subjects: List[str]
    address: Address

    # Custom validator for subjects
    @field_validator("subjects")
    def check_subjects(cls, v):
        if len(v) == 0:
            raise ValueError("Student must have at least one subject")
        return v

# Example usage
try:
    student = Student(
        id="101",  # string will be converted to int
        name="Jeevan",
        age=20,
        subjects=["Math", "Science"],
        address={"city": "Vijayawada", "zip": "520001"}
    )
    print(student)
    print(student.model_dump())       # ✅ replaces dict()
    print(student.model_dump_json())  # ✅ replaces json()
except Exception as e:
    print("Validation Error:", e)

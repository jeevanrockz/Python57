import requests
from pydantic import BaseModel, Field, ValidationError
from typing import Optional

# Define schema for weather data
class Weather(BaseModel):
    city: str
    temperature: float = Field(gt=-100, lt=100, description="Temperature must be realistic")
    condition: str
    humidity: Optional[int] = Field(default=None, ge=0, le=100)

# Simulated API call (replace with a real API like OpenWeatherMap)
def fetch_weather(city: str):
    # Fake response (in real case: requests.get(...).json())
    response = {
        "city": city,
        "temperature": "32.5",   # string, will be converted to float
        "condition": "Sunny",
        "humidity": 70
    }
    return response

# Usage
try:
    raw_data = fetch_weather("Vijayawada")
    weather = Weather(**raw_data)  # Pydantic validates and converts
    print(weather)
    print(weather.model_dump_json())  # Clean JSON output
except ValidationError as e:
    print("Validation Error:", e)

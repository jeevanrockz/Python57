book library manager:-

from pydantic import BaseModel, Field, ConfigDict, computed_field, field_validator
from typing import Optional, Union, List
from pydantic_settings import BaseSettings  # ✅ Correct import for settings

# Settings management (reads from environment variables too)
class Settings(BaseSettings):
    library_name: str = "My Library"
    debug: bool = False

settings = Settings()

# Book model
class Book(BaseModel):
    # Aliases: external name "book_id" maps to internal "id"
    id: int = Field(alias="book_id")
    title: str
    author: str
    pages: int = Field(gt=0, description="Pages must be positive")
    rating: Optional[float] = None  # Optional field
    genre: Union[str, List[str]]    # Union type: can be a single genre or list of genres

    model_config = ConfigDict(strict=True)  # Strict mode: no auto-conversion

    # Custom validator for rating
    @field_validator("rating")
    def check_rating(cls, v):
        if v is not None and not (0 <= v <= 5):
            raise ValueError("Rating must be between 0 and 5")
        return v

    # Computed field: summary
    @computed_field
    @property
    def summary(self) -> str:
        return f"{self.title} by {self.author} ({self.pages} pages)"

# Example usage
try:
    book = Book(
        book_id=101,  # alias used here
        title="Python Mastery",
        author="Jeevan",
        pages=350,
        rating=4.5,
        genre=["Programming", "Education"]
    )

    print(f"Library: {settings.library_name}")
    print(book.summary)             # Computed field
    print(book.model_dump())        # Serialization
    print(book.model_dump_json())   # JSON serialization

except Exception as e:
    print("Validation Error:", e)

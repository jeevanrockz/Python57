from pydantic import BaseModel, Field, ConfigDict, computed_field, field_validator
from typing import Optional, Union, List

# Nested model for transactions
class Transaction(BaseModel):
    id: int
    type: str = Field(pattern="^(deposit|withdrawal)$", description="Must be deposit or withdrawal")
    amount: float = Field(gt=0, description="Amount must be positive")
    note: Optional[str] = None

class Account(BaseModel):
    account_number: str
    owner: str
    balance: float = Field(ge=0, description="Balance cannot be negative")
    transactions: List[Transaction] = []

    model_config = ConfigDict(strict=True)  # Strict mode: no auto-conversion

    # Validator: ensure account number format
    @field_validator("account_number")
    def check_account_number(cls, v):
        if not v.isdigit() or len(v) != 10:
            raise ValueError("Account number must be 10 digits")
        return v

    # Computed field: total deposits
    @computed_field
    @property
    def total_deposits(self) -> float:
        return sum(t.amount for t in self.transactions if t.type == "deposit")

    # Computed field: total withdrawals
    @computed_field
    @property
    def total_withdrawals(self) -> float:
        return sum(t.amount for t in self.transactions if t.type == "withdrawal")

# Example usage
try:
    account = Account(
        account_number="1234567890",
        owner="Jeevan",
        balance=5000,
        transactions=[
            {"id": 1, "type": "deposit", "amount": 2000, "note": "Salary"},
            {"id": 2, "type": "withdrawal", "amount": 500, "note": "Groceries"}
        ]
    )

    print(account)
    print("Total Deposits:", account.total_deposits)
    print("Total Withdrawals:", account.total_withdrawals)
    print(account.model_dump_json())  # Clean JSON output

except Exception as e:
    print("Validation Error:", e)

from pydantic import BaseModel, Field, ConfigDict, computed_field, field_validator
from typing import Optional, Union, List

class Review(BaseModel):
    reviewer: str
    rating: Optional[float] = Field(default=None, ge=0, le=5, description="Rating must be between 0 and 5")
    comment: Optional[str] = None

class Movie(BaseModel):
    id: int
    title: str
    director: str
    year: int = Field(ge=1900, le=2026, description="Year must be realistic")
    genres: Union[str, List[str]]  # Can be a single genre or multiple
    reviews: List[Review] = []

    model_config = ConfigDict(strict=True)  # Strict mode: no auto-conversion

    # Validator: ensure at least one genre
    @field_validator("genres")
    def check_genres(cls, v):
        if isinstance(v, list) and len(v) == 0:
            raise ValueError("Movie must have at least one genre")
        return v

    # Computed field: average rating
    @computed_field
    @property
    def average_rating(self) -> Optional[float]:
        if not self.reviews:
            return None
        return round(sum(r.rating for r in self.reviews if r.rating is not None) / len(self.reviews), 2)

# Example usage
try:
    movie = Movie(
        id=1,
        title="Python Adventures",
        director="Jeevan",
        year=2025,
        genres=["Education", "Adventure"],
        reviews=[
            {"reviewer": "Alice", "rating": 4.5, "comment": "Great movie!"},
            {"reviewer": "Bob", "rating": 5.0, "comment": "Loved it!"}
        ]
    )

    print(movie)
    print("Average Rating:", movie.average_rating)
    print(movie.model_dump_json())  # Clean JSON output

except Exception as e:
    print("Validation Error:", e)


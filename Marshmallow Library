from marshmallow import Schema, fields, validates, ValidationError, pre_load, post_dump

# Address schema
class AddressSchema(Schema):
    city = fields.Str(required=True)
    zip = fields.Str(required=True)

# Order schema
class OrderSchema(Schema):
    product = fields.Str(required=True)
    quantity = fields.Int(load_default=1)  # default if missing
    price = fields.Float(required=True)

    @validates("quantity")
    def validate_quantity(self, value, **kwargs):  # <-- add **kwargs
        if value <= 0:
            raise ValidationError("Quantity must be greater than 0.")

# User schema
class UserSchema(Schema):
    id = fields.Int(required=True)
    name = fields.Str(required=True)
    email = fields.Email(required=True, load_only=True)  # only used in input
    active = fields.Bool(dump_default=True)  # default when serializing
    address = fields.Nested(AddressSchema, required=True)
    orders = fields.List(fields.Nested(OrderSchema))

    @pre_load
    def clean_name(self, data, **kwargs):
        # Trim whitespace before validation
        data["name"] = data["name"].strip()
        return data

    @post_dump
    def calculate_total(self, data, **kwargs):
        # Add computed field after serialization
        total = sum(order["quantity"] * order["price"] for order in data.get("orders", []))
        data["total_spent"] = total
        return data

# Example usage
schema = UserSchema()

input_data = {
    "id": "1",
    "name": "  Jeevan  ",
    "email": "jeevan@example.com",
    "address": {"city": "Vijayawada", "zip": "520001"},
    "orders": [
        {"product": "Book", "quantity": 2, "price": 150},
        {"product": "Pen", "price": 20}  # quantity defaults to 1
    ]
}

# Deserialize (load)
user = schema.load(input_data)
print("Deserialized:", user)

# Serialize (dump)
output = schema.dump(user)
print("Serialized:", output)

from marshmallow import Schema, fields, validates, ValidationError, post_dump

# Product schema
class ProductSchema(Schema):
    name = fields.Str(required=True)
    price = fields.Float(required=True)

# Cart Item schema
class CartItemSchema(Schema):
    product = fields.Nested(ProductSchema, required=True)
    quantity = fields.Int(load_default=1)

    @validates("quantity")
    def validate_quantity(self, value, **kwargs):
        if value <= 0:
            raise ValidationError("Quantity must be greater than 0.")

# Cart schema
class CartSchema(Schema):
    items = fields.List(fields.Nested(CartItemSchema), required=True)

    @post_dump
    def calculate_total(self, data, **kwargs):
        total = sum(item["product"]["price"] * item["quantity"] for item in data["items"])
        data["total_price"] = total
        return data

# Example usage
schema = CartSchema()

input_data = {
    "items": [
        {"product": {"name": "Laptop", "price": 50000}, "quantity": 1},
        {"product": {"name": "Mouse", "price": 500}, "quantity": 2},
        {"product": {"name": "Keyboard", "price": 1500}}  # quantity defaults to 1
    ]
}

# Deserialize (load)
cart = schema.load(input_data)
print("Deserialized:", cart)

# Serialize (dump)
output = schema.dump(cart)
print("Serialized:", output)

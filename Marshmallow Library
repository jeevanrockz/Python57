from marshmallow import Schema, fields, validates, ValidationError, pre_load, post_dump

# Sub-schema for tags
class TagSchema(Schema):
    name = fields.Str(required=True)

# Main Task schema
class TaskSchema(Schema):
    id = fields.Int(required=True)
    title = fields.Str(required=True)
    description = fields.Str(load_default="No description provided")
    completed = fields.Bool(load_default=False, dump_default=False)
    priority = fields.Int(load_default=1)

    tags = fields.List(fields.Nested(TagSchema))

    @validates("priority")
    def validate_priority(self, value, **kwargs):
        if value < 1 or value > 5:
            raise ValidationError("Priority must be between 1 and 5.")

    @pre_load
    def strip_title(self, data, **kwargs):
        # Clean whitespace before validation
        data["title"] = data["title"].strip()
        return data

    @post_dump
    def add_status(self, data, **kwargs):
        # Add a computed field after serialization
        data["status"] = "Done" if data["completed"] else "Pending"
        return data

# Example usage
schema = TaskSchema()

input_data = {
    "id": "101",
    "title": "  Learn Marshmallow  ",
    "tags": [{"name": "python"}, {"name": "validation"}],
    "priority": 3
}

# Deserialize (load)
task = schema.load(input_data)
print("Deserialized:", task)

# Serialize (dump)
output = schema.dump(task)
print("Serialized:", output)

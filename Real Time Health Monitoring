from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session
from app.database import get_db
from app import models, schemas

router = APIRouter()

@router.post("/", response_model=schemas.Vital)
def create_vital(vital: schemas.VitalCreate, db: Session = Depends(get_db)):
    db_vital = models.Vital(
        patient_id=vital.patient_id,
        heart_rate=vital.heart_rate,
        temperature=vital.temperature,
        oxygen_level=vital.oxygen_level
    )
    db.add(db_vital)
    db.commit()
    db.refresh(db_vital)
    return db_vital

@router.get("/{vital_id}", response_model=schemas.Vital)
def read_vital(vital_id: int, db: Session = Depends(get_db)):
    return db.query(models.Vital).filter(models.Vital.id == vital_id).first()

@router.get("/", response_model=list[schemas.Vital])
def list_vitals(skip: int = 0, limit: int = 10, db: Session = Depends(get_db)):
    return db.query(models.Vital).offset(skip).limit(limit).all()


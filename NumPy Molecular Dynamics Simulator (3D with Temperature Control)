import numpy as np
import matplotlib.pyplot as plt

# -----------------------------
# Step 1: Setup
# -----------------------------
N = 50              # number of particles
L = 10.0            # box size (cube)
dt = 0.01           # time step
steps = 1000        # simulation steps

epsilon = 1.0       # Lennard-Jones parameter
sigma = 1.0         # Lennard-Jones parameter
target_temp = 1.0   # target temperature (arbitrary units)

# Initialize positions randomly inside the cube
positions = np.random.rand(N, 3) * L

# Initialize velocities with small random values
velocities = np.random.randn(N, 3) * 0.1

# -----------------------------
# Step 2: Force Calculation (Lennard-Jones)
# -----------------------------
def compute_forces(positions):
    forces = np.zeros_like(positions)
    potential_energy = 0.0
    for i in range(N):
        for j in range(i+1, N):
            rij = positions[i] - positions[j]
            # Apply periodic boundary conditions
            rij -= L * np.round(rij / L)
            r = np.linalg.norm(rij)
            if r < 3*sigma and r > 1e-6:  # cutoff and avoid division by zero
                f = 24*epsilon*(2*(sigma**12)/(r**13) - (sigma**6)/(r**7)) * rij
                forces[i] += f
                forces[j] -= f
                potential_energy += 4*epsilon*((sigma/r)**12 - (sigma/r)**6)
    return forces, potential_energy

# -----------------------------
# Step 3: Velocity Verlet Integration
# -----------------------------
def velocity_verlet(positions, velocities):
    forces, pe = compute_forces(positions)
    positions += velocities*dt + 0.5*forces*dt**2
    new_forces, pe = compute_forces(positions)
    velocities += 0.5*(forces + new_forces)*dt
    return positions % L, velocities, pe

# -----------------------------
# Step 4: Temperature Control (Velocity Rescaling)
# -----------------------------
def rescale_velocities(velocities, target_temp):
    kinetic_energy = 0.5*np.sum(velocities**2)
    current_temp = (2*kinetic_energy) / (3*N)  # equipartition theorem
    scale_factor = np.sqrt(target_temp / current_temp)
    return velocities * scale_factor, current_temp

# -----------------------------
# Step 5: Simulation Loop
# -----------------------------
energies = []
temperatures = []

for step in range(steps):
    positions, velocities, pe = velocity_verlet(positions, velocities)
    velocities, temp = rescale_velocities(velocities, target_temp)
    ke = 0.5*np.sum(velocities**2)
    energies.append((ke, pe, ke+pe))
    temperatures.append(temp)

# -----------------------------
# Step 6: Visualization
# -----------------------------
energies = np.array(energies)

plt.figure(figsize=(12,5))

plt.subplot(1,2,1)
plt.plot(energies[:,0], label="Kinetic Energy")
plt.plot(energies[:,1], label="Potential Energy")
plt.plot(energies[:,2], label="Total Energy")
plt.legend()
plt.title("Energy vs Time")
plt.xlabel("Step")
plt.ylabel("Energy")

plt.subplot(1,2,2)
plt.plot(temperatures, label="Temperature", color="red")
plt.axhline(y=target_temp, color="black", linestyle="--", label="Target Temp")
plt.legend()
plt.title("Temperature Control")
plt.xlabel("Step")
plt.ylabel("Temperature")

plt.tight_layout()
plt.show()

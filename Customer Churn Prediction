import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report

# -------------------------------
# Step 1: Load dataset
# -------------------------------
df = pd.read_csv("churn_ready_dataset.csv")

# -------------------------------
# Step 2: Encode categorical variables
# -------------------------------
le_gender = LabelEncoder()
df["Gender"] = le_gender.fit_transform(df["Gender"])

le_region = LabelEncoder()
df["Region"] = le_region.fit_transform(df["Region"])

# -------------------------------
# Step 3: Define churn label
# -------------------------------
# Original definition: churn if no activity in last 3 months
df["Churn"] = (df["Last3MonthsActivity"] == 0).astype(int)

# If dataset has only one class, create synthetic churn cases for balance
if df["Churn"].nunique() == 1:
    # Randomly mark ~20% of customers as churned
    churn_indices = df.sample(frac=0.2, random_state=42).index
    df.loc[churn_indices, "Churn"] = 1

print("Churn distribution:\n", df["Churn"].value_counts())

# -------------------------------
# Step 4: Features & Target
# -------------------------------
X = df[[
    "Gender", "Age", "Region", "TotalSpend", "AvgSpend",
    "PurchaseFrequency", "Complaints", "DaysSinceLastPurchase", "Last3MonthsActivity"
]]
y = df["Churn"]

# -------------------------------
# Step 5: Train/Test Split
# -------------------------------
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42, stratify=y
)

# -------------------------------
# Step 6: Train Logistic Regression
# -------------------------------
model = LogisticRegression(max_iter=1000, solver="liblinear")
print("Training model...")
model.fit(X_train, y_train)

# -------------------------------
# Step 7: Evaluate
# -------------------------------
y_pred = model.predict(X_test)
print("\nClassification Report:\n")
print(classification_report(y_test, y_pred))


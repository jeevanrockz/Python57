import pandas as pd
import numpy as np

# -------------------------------
# Step 1: Load multiple datasets
# -------------------------------
customers = pd.read_csv("customers.csv")          # demographics
transactions = pd.read_csv("transactions.csv")    # purchase history
support = pd.read_csv("support_tickets.csv")      # complaints

# -------------------------------
# Step 2: Clean & normalize data
# -------------------------------
# Convert dates safely
customers["JoinDate"] = pd.to_datetime(customers["JoinDate"], errors="coerce")
transactions["Date"] = pd.to_datetime(transactions["Date"], errors="coerce")
support["TicketDate"] = pd.to_datetime(support["TicketDate"], errors="coerce")

# Fill missing values (direct assignment instead of inplace=True)
customers["Gender"] = customers["Gender"].fillna("Unknown")
customers["Age"] = customers["Age"].fillna(customers["Age"].median())
transactions["Amount"] = transactions["Amount"].fillna(0)
support["TicketID"] = support["TicketID"].fillna("NoTicket")

# Normalize categorical features
customers["Gender"] = customers["Gender"].str.strip().str.title()
customers["Region"] = customers["Region"].str.strip().str.title()

# -------------------------------
# Step 3: Merge datasets
# -------------------------------
df = customers.merge(transactions, on="CustomerID", how="left")
df = df.merge(support, on="CustomerID", how="left")

# -------------------------------
# Step 4: Feature Engineering
# -------------------------------
# Total spend per customer
df["TotalSpend"] = df.groupby("CustomerID")["Amount"].transform("sum")

# Average spend per transaction
df["AvgSpend"] = df.groupby("CustomerID")["Amount"].transform("mean")

# Purchase frequency
df["PurchaseFrequency"] = df.groupby("CustomerID")["Date"].transform("count")

# Complaint counts
df["Complaints"] = df.groupby("CustomerID")["TicketID"].transform("count")

# -------------------------------
# Step 5: Lag Features (Recent Activity)
# -------------------------------
# Days since last purchase
df["DaysSinceLastPurchase"] = df.groupby("CustomerID")["Date"].transform(
    lambda x: (x.max() - x.min()).days if len(x.dropna()) > 0 else np.nan
)

# Activity in last 90 days
recent_activity = transactions[transactions["Date"] > (transactions["Date"].max() - pd.Timedelta(days=90))]
recent_counts = recent_activity.groupby("CustomerID")["Amount"].count().reset_index()
recent_counts.rename(columns={"Amount": "Last3MonthsActivity"}, inplace=True)

df = df.merge(recent_counts, on="CustomerID", how="left")
df["Last3MonthsActivity"] = df["Last3MonthsActivity"].fillna(0)

# -------------------------------
# Step 6: Export for ML
# -------------------------------
final_dataset = df[[
    "CustomerID", "Gender", "Age", "Region",
    "TotalSpend", "AvgSpend", "PurchaseFrequency",
    "Complaints", "DaysSinceLastPurchase", "Last3MonthsActivity"
]].drop_duplicates("CustomerID")

final_dataset.to_csv("churn_ready_dataset.csv", index=False)

print("✅ Customer churn dataset prepared successfully!")


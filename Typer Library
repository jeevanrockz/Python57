import typer
from loguru import logger
import random

app = typer.Typer()

# Fake weather data generator
def generate_weather(city: str):
    conditions = ["Sunny", "Cloudy", "Rainy", "Stormy", "Windy"]
    temperature = random.randint(20, 40)
    condition = random.choice(conditions)
    return f"Weather in {city}: {condition}, {temperature}°C"

@app.command()
def current(city: str):
    """
    Show the current weather for a city.
    """
    report = generate_weather(city)
    logger.info(f"Checked current weather for {city}")
    typer.echo(report)

@app.command()
def forecast(city: str, days: int = 3):
    """
    Show a forecast for the next N days.
    """
    typer.echo(f"Forecast for {city}:")
    for day in range(1, days + 1):
        report = generate_weather(city)
        logger.info(f"Forecast day {day} for {city}")
        typer.echo(f"Day {day}: {report}")

if __name__ == "__main__":
    app()

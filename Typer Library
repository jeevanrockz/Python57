import typer
import json
import os
from pathlib import Path
from loguru import logger
import secrets
import string

app = typer.Typer()

DATA_FILE = Path("passwords.json")

# Ensure file exists
if not DATA_FILE.exists():
    with open(DATA_FILE, "w") as f:
        json.dump({}, f)

def load_data():
    with open(DATA_FILE, "r") as f:
        return json.load(f)

def save_data(data):
    with open(DATA_FILE, "w") as f:
        json.dump(data, f, indent=4)

@app.command()
def add(service: str, username: str, password: str = typer.Option(None, help="Provide a password or generate one")):
    """
    Add a new password entry for a service.
    """
    data = load_data()
    if not password:
        # Generate a secure random password
        alphabet = string.ascii_letters + string.digits + string.punctuation
        password = ''.join(secrets.choice(alphabet) for _ in range(16))
        typer.echo("🔑 Generated secure password.")

    data[service] = {"username": username, "password": password}
    save_data(data)
    logger.info(f"Added password for {service}")
    typer.echo(f"✅ Password saved for {service}")

@app.command()
def list():
    """
    List all saved services.
    """
    data = load_data()
    if not data:
        typer.echo("No passwords stored yet.")
        return
    typer.echo("📂 Stored services:")
    for service in data.keys():
        typer.echo(f"- {service}")

@app.command()
def get(service: str):
    """
    Retrieve the username and password for a service.
    """
    data = load_data()
    if service in data:
        entry = data[service]
        logger.info(f"Retrieved password for {service}")
        typer.echo(f"Service: {service}")
        typer.echo(f"Username: {entry['username']}")
        typer.echo(f"Password: {entry['password']}")
    else:
        typer.echo("❌ Service not found.")

@app.command()
def delete(service: str):
    """
    Delete a stored password entry.
    """
    data = load_data()
    if service in data:
        del data[service]
        save_data(data)
        logger.info(f"Deleted password for {service}")
        typer.echo(f"🗑️ Deleted password for {service}")
    else:
        typer.echo("❌ Service not found.")

if __name__ == "__main__":
    app()

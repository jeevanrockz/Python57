import typer
from typing import List
from loguru import logger

app = typer.Typer()

# In-memory task list
tasks: List[str] = []

@app.command()
def add(task: str):
    """
    Add a new task to the list.
    """
    tasks.append(task)
    logger.info(f"Task added: {task}")
    typer.echo(f"✅ Added task: {task}")

@app.command()
def list():
    """
    List all tasks.
    """
    if not tasks:
        typer.echo("No tasks found.")
        return
    typer.echo("📋 Your tasks:")
    for i, task in enumerate(tasks, start=1):
        typer.echo(f"{i}. {task}")

@app.command()
def complete(task_number: int):
    """
    Mark a task as completed by its number.
    """
    if 0 < task_number <= len(tasks):
        task = tasks.pop(task_number - 1)
        logger.info(f"Task completed: {task}")
        typer.echo(f"✅ Completed task: {task}")
    else:
        typer.echo("❌ Invalid task number.")

if __name__ == "__main__":
    app()

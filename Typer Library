import typer
import json
from pathlib import Path
from loguru import logger
from typing import Optional

app = typer.Typer()

DATA_FILE = Path("notes.json")

# Ensure file exists
if not DATA_FILE.exists():
    with open(DATA_FILE, "w") as f:
        json.dump([], f)

def load_notes():
    with open(DATA_FILE, "r") as f:
        return json.load(f)

def save_notes(notes):
    with open(DATA_FILE, "w") as f:
        json.dump(notes, f, indent=4)

@app.command()
def add(title: str, content: str):
    """
    Add a new note with a title and content.
    """
    notes = load_notes()
    note = {"title": title, "content": content}
    notes.append(note)
    save_notes(notes)
    logger.info(f"Added note: {title}")
    typer.echo(f"✅ Note '{title}' added.")

@app.command()
def list():
    """
    List all notes.
    """
    notes = load_notes()
    if not notes:
        typer.echo("No notes found.")
        return
    typer.echo("📒 Your notes:")
    for i, note in enumerate(notes, start=1):
        typer.echo(f"{i}. {note['title']}")

@app.command()
def search(keyword: str):
    """
    Search notes by keyword in title or content.
    """
    notes = load_notes()
    results = [note for note in notes if keyword.lower() in note["title"].lower() or keyword.lower() in note["content"].lower()]
    if not results:
        typer.echo("❌ No matching notes found.")
        return
    typer.echo(f"🔍 Found {len(results)} matching notes:")
    for note in results:
        typer.echo(f"- {note['title']}: {note['content']}")

@app.command()
def delete(title: str):
    """
    Delete a note by its title.
    """
    notes = load_notes()
    filtered = [note for note in notes if note["title"].lower() != title.lower()]
    if len(filtered) == len(notes):
        typer.echo("❌ Note not found.")
        return
    save_notes(filtered)
    logger.info(f"Deleted note: {title}")
    typer.echo(f"🗑️ Note '{title}' deleted.")

@app.command()
def view(title: str):
    """
    View the content of a note by title.
    """
    notes = load_notes()
    for note in notes:
        if note["title"].lower() == title.lower():
            typer.echo(f"📖 {note['title']}: {note['content']}")
            return
    typer.echo("❌ Note not found.")

if __name__ == "__main__":
    app()

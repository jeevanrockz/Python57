    def __init__(self):
        """Initialize the startup analyzer"""
        self.startup_programs = []
        self.unnecessary_programs = []
        self.harmful_programs = []
        self.essential_programs = []
    
    def get_registry_startup_programs(self) -> List[Dict]:
        """Get startup programs from Windows registry"""
        programs = []
        
        if sys.platform != 'win32':
            print("Registry scan only works on Windows")
            return programs
        
        # Registry paths to check
        registry_paths = [
            (r'SOFTWARE\Microsoft\Windows\CurrentVersion\Run', 'HKLM'),
            (r'SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Run', 'HKLM'),
            (r'SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce', 'HKLM'),
        ]
        
        for reg_path, hive in registry_paths:
            try:
                if hive == 'HKLM':
                    reg_key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, reg_path)
                else:
                    reg_key = winreg.OpenKey(winreg.HKEY_CURRENT_USER, reg_path)
                
                value_count = winreg.QueryInfoKey(reg_key)[1]
                
                for i in range(value_count):
                    try:
                        name, value, _ = winreg.EnumValue(reg_key, i)
                        
                        programs.append({
                            'name': name,
                            'path': value,
                            'location': f'Registry: {hive}\\{reg_path}',
                            'type': 'Registry'
                        })
                    except WindowsError:
                        pass
                
                winreg.CloseKey(reg_key)
            
            except WindowsError:
                pass
        
        return programs
    
    def get_startup_folder_programs(self) -> List[Dict]:
        """Get programs from Windows startup folders"""
        programs = []
        
        startup_paths = [
            Path(os.environ.get('PROGRAMDATA', 'C:\\ProgramData')) / 'Microsoft\\Windows\\Start Menu\\Programs\\Startup',
            Path(os.environ.get('APPDATA', '')) / 'Microsoft\\Windows\\Start Menu\\Programs\\Startup'
        ]
        
        for startup_path in startup_paths:
            if startup_path.exists():
                try:
                    for item in startup_path.glob('*'):
                        if item.is_file():
                            programs.append({
                                'name': item.stem,
                                'path': str(item),
                                'location': str(startup_path),
                                'type': 'Startup Folder',
                                'file_size': item.stat().st_size,
                                'modified': datetime.fromtimestamp(item.stat().st_mtime).strftime('%Y-%m-%d %H:%M:%S')
                            })
                except Exception:
                    pass
        
        return programs
    
    def get_scheduled_tasks_startup(self) -> List[Dict]:
        """Get startup programs from Windows Scheduled Tasks"""
        programs = []
        
        if sys.platform != 'win32':
            return programs
        
        # Common scheduled task startup locations
        task_paths = [
            r'SOFTWARE\Microsoft\Windows NT\CurrentVersion\Schedule\TaskCache\Tasks',
        ]
        
        try:
            reg_key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, task_paths[0])
            sub_keys = winreg.QueryInfoKey(reg_key)[0]
            
            for i in range(sub_keys):
                try:
                    sub_key_name = winreg.EnumKey(reg_key, i)
                    sub_key = winreg.OpenKey(reg_key, sub_key_name)
                    
                    try:
                        path, _ = winreg.QueryValueEx(sub_key, 'Path')
                        # Only show tasks that look like startup tasks
                        if 'startup' in path.lower() or 'run' in path.lower():
                            programs.append({
                                'name': path,
                                'path': f'Task: {path}',
                                'location': 'Scheduled Tasks',
                                'type': 'Scheduled Task'
                            })
                    except WindowsError:
                        pass
                    
                    winreg.CloseKey(sub_key)
                except WindowsError:
                    pass
            
            winreg.CloseKey(reg_key)
        except WindowsError:
            pass
        
        return programs
    
    def classify_program(self, program_name: str) -> Dict:
        """Classify a program as essential, unnecessary, or harmful"""
        name_lower = program_name.lower()
        
        # Check if harmful
        for harmful, info in self.HARMFUL_STARTUP_PROGRAMS.items():
            if harmful in name_lower:
                return {'category': 'HARMFUL', **info}
        
        # Check if unnecessary
        for unnecessary, info in self.UNNECESSARY_PROGRAMS.items():
            if unnecessary in name_lower:
                return {'category': 'UNNECESSARY', **info}
        
        # Check if essential
        for essential in self.ESSENTIAL_STARTUP_PROGRAMS:
            if essential in name_lower:
                return {'category': 'ESSENTIAL', 'reason': 'System or commonly needed program'}
        
        # Default to unknown
        return {'category': 'UNKNOWN', 'reason': 'Unable to classify automatically'}
    
    def scan_startup_programs(self):
        """Scan for all startup programs"""
        print(f"\n{'='*80}")
        print(f" STARTUP PROGRAM ANALYZER ".center(80, "="))
        print(f"{'='*80}\n")
        
        print("Scanning startup programs from multiple sources...\n")
        
        # Get from registry
        print("Scanning registry...", end='', flush=True)
        registry_programs = self.get_registry_startup_programs()
        print(f" Found {len(registry_programs)}")
        
        # Get from startup folders
        print("Scanning startup folders...", end='', flush=True)
        folder_programs = self.get_startup_folder_programs()
        print(f" Found {len(folder_programs)}")
        
        # Get from scheduled tasks
        print("Scanning scheduled tasks...", end='', flush=True)
        task_programs = self.get_scheduled_tasks_startup()
        print(f" Found {len(task_programs)}")
        
        # Combine and classify
        self.startup_programs = registry_programs + folder_programs + task_programs
        
        for program in self.startup_programs:
            classification = self.classify_program(program['name'])
            program['classification'] = classification
            
            if classification['category'] == 'HARMFUL':
                self.harmful_programs.append(program)
            elif classification['category'] == 'UNNECESSARY':
                self.unnecessary_programs.append(program)
            elif classification['category'] == 'ESSENTIAL':
                self.essential_programs.append(program)
        
        print(f"\nTotal startup programs found: {len(self.startup_programs)}\n")
    

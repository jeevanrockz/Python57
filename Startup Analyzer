        print(f"Unnecessary Programs: {len(self.unnecessary_programs)}")
        print(f"Harmful Programs: {len(self.harmful_programs)}\n")
        
        # Display harmful programs
        if self.harmful_programs:
            self._display_harmful_programs()
        
        # Display unnecessary programs
        if self.unnecessary_programs:
            self._display_unnecessary_programs()
        
        # Display all programs
        self._display_all_programs()
    
    def _display_harmful_programs(self):

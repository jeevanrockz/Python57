            print(f"🟡 IMPROVEMENT: Disable {total_unnecessary} unnecessary program(s)")
            print("   Action: This will improve startup time and free up resources\n")
        
        if total_unnecessary == 0 and total_harmful == 0:
            print("✓ Your startup programs look good!")
            print("   No harmful or unnecessary programs detected\n")
        
        # Startup time impact estimate
        if total_unnecessary > 0:
            estimated_improvement = total_unnecessary * 2  # Rough estimate: 2 seconds per program
            print(f"Estimated startup improvement: ~{estimated_improvement} seconds\n")
        
        print("HOW TO DISABLE UNNECESSARY PROGRAMS:")
        print("  1. Press Win + R")
        print("  2. Type 'msconfig' and press Enter")
        print("  3. Go to 'Startup' tab")
        print("  4. Uncheck programs you want to disable")
        print("  5. Click 'Apply' and 'OK'")
        print("  6. Restart your computer\n")
        
        print("ALTERNATIVE METHOD - Task Manager:")
        print("  1. Press Ctrl + Shift + Esc (Task Manager)")
        print("  2. Click 'Startup' tab")

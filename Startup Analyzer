        print("="*80 + "\n")
    
    def save_report(self, filename: str = 'startup_analysis_report.json'):
        """Save analysis report to JSON file"""
        report = {
            'scan_time': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'total_programs': len(self.startup_programs),
            'essential_count': len(self.essential_programs),
            'unnecessary_count': len(self.unnecessary_programs),
            'harmful_count': len(self.harmful_programs),
            'programs': self.startup_programs
        }
        
        try:
            with open(filename, 'w', encoding='utf-8') as f:
                json.dump(report, f, indent=2, ensure_ascii=False)
            
            print(f"\n{'='*80}")
            print(f"Report saved to: {filename}")
            print(f"{'='*80}\n")
        except Exception as e:
            print(f"Error saving report: {e}")



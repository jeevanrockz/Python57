            info = prog['classification']
            print(f"{idx}. {prog['name']}")
            print(f"   Risk: {info['risk']}")
            print(f"   Reason: {info['reason']}")
            print(f"   Location: {prog['location']}")
            print()
    
    def _display_unnecessary_programs(self):
        """Display unnecessary startup programs"""
        print("🟡 UNNECESSARY STARTUP PROGRAMS (Can be Disabled):\n")
        
        for idx, prog in enumerate(self.unnecessary_programs, 1):
            info = prog['classification']
            print(f"{idx}. {prog['name']}")

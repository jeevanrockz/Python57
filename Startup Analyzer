        print(f"{'='*80}\n")
        
        print(f"{'Program Name':<40} {'Category':<15} {'Status':<20}")
        print("-" * 75)
        
        for prog in sorted(self.startup_programs, key=lambda x: x['name']):
            category = prog['classification']['category']
            
            if category == 'HARMFUL':
                status = "🔴 REMOVE"
            elif category == 'UNNECESSARY':
                status = "🟡 CAN DISABLE"
            elif category == 'ESSENTIAL':
                status = "🟢 KEEP"
            else:
                status = "❓ UNKNOWN"
            
            name = prog['name'][:39]
            print(f"{name:<40} {category:<15} {status:<20}")
        
        print("\n" + "="*80 + "\n")
    
    def get_optimization_recommendations(self):

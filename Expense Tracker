from flask import Flask, render_template, request, redirect, url_for
import csv
import mysql.connector

app = Flask(__name__)

# Configure MySQL connection
db_config = {
    "host": "localhost",
    "user": "root",          # replace with your MySQL username
    "password": "password",  # replace with your MySQL password
    "database": "clipboard_db"
}

@app.route("/")
def index():
    conn = mysql.connector.connect(**db_config)
    cursor = conn.cursor()

    # Expenses by category
    cursor.execute("SELECT category, SUM(amount) FROM expenses GROUP BY category")
    category_data = cursor.fetchall()

    # Spending trend by date
    cursor.execute("SELECT date, SUM(amount) FROM expenses GROUP BY date ORDER BY date")
    trend_data = cursor.fetchall()

    conn.close()

    categories = [row[0] for row in category_data]
    values = [row[1] for row in category_data]
    dates = [str(row[0]) for row in trend_data]
    totals = [row[1] for row in trend_data]

    return render_template("expenses.html",
                           categories=categories,
                           values=values,
                           dates=dates,
                           totals=totals)

@app.route("/upload", methods=["POST"])
def upload():
    file = request.files["file"]
    if file and file.filename.endswith(".csv"):
        conn = mysql.connector.connect(**db_config)
        cursor = conn.cursor()
        reader = csv.DictReader(file.stream.read().decode("utf-8").splitlines())
        for row in reader:
            cursor.execute("INSERT INTO expenses (category, amount, date) VALUES (%s, %s, %s)",
                           (row["Category"], float(row["Amount"]), row["Date"]))
        conn.commit()
        conn.close()
    return redirect(url_for("index"))

if __name__ == "__main__":
    app.run(debug=True)


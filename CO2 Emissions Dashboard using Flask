from flask import Flask, render_template
import csv

app = Flask(__name__)

def read_csv(filename):
    data = []
    with open(filename, newline='', encoding='utf-8') as f:
        reader = csv.DictReader(f)
        for row in reader:
            data.append(row)
    return data

@app.route("/")
def index():
    data = read_csv(r"C:\Users\jeeva\OneDrive\Desktop\Emissions.csv")  # Replace with your file path

    # Preprocess safely
    countries = [row.get("Country", "") for row in data]
    emissions_1997 = []
    for row in data:
        try:
            emissions_1997.append(float(row.get("1997", 0)))
        except ValueError:
            emissions_1997.append(0)

    return render_template("dashboard.html",
                           countries=countries,
                           emissions=emissions_1997)

if __name__ == "__main__":
    app.run(debug=True)



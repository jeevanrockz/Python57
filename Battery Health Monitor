#!/usr/bin/env python3
"""
Battery Health Monitor - Tracks battery percentage, charge cycles, and estimated health
Provides real-time monitoring and historical data logging
"""

import os
import sys
import json
import csv
from datetime import datetime
from pathlib import Path
from typing import Dict, Optional, List
import time

# For Windows battery info
if sys.platform == 'win32':
    import psutil
    try:
        import wmi
    except ImportError:
        wmi = None


class BatteryHealthMonitor:
    """Monitor and track laptop battery health"""
    
    def __init__(self, log_file: str = 'battery_logs.csv', data_file: str = 'battery_data.json'):
        """
        Initialize the battery monitor.
        
        Args:
            log_file: CSV file to store historical logs
            data_file: JSON file to store battery metrics
        """
        self.log_file = log_file
        self.data_file = data_file
        self.current_battery = None
        self.battery_history = []
        self.load_history()
    
    def get_battery_info(self) -> Optional[Dict]:
        """Get detailed battery information"""
        if sys.platform != 'win32':
            print("Battery monitoring is primarily supported on Windows")
            return None
        
        try:
            battery = psutil.sensors_battery()
            
            if battery:
                return {
                    'percent': battery.percent,
                    'power_plugged': battery.power_plugged,
                    'time_left': battery.secsleft,
                    'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S')
                }
        except Exception as e:
            print(f"Error reading battery: {e}")
        
        return None
    
    def get_battery_report(self) -> Optional[Dict]:
        """Generate battery report using Windows command"""
        if sys.platform != 'win32':
            return None
        
        try:
            # Generate battery report
            os.system('powercfg /batteryreport /output:battery_report.html')
            
            # Try to read battery information from WMI
            if wmi:
                try:
                    c = wmi.WMI()
                    battery_info = c.query('SELECT * FROM Win32_Battery')
                    if battery_info:
                        b = battery_info[0]
                        return {
                            'name': b.Name,
                            'status': b.Status,
                            'charge_percent': b.EstimatedChargeRemaining
                        }
                except Exception:
                    pass
        except Exception as e:
            print(f"Error generating battery report: {e}")
        
        return None
    
    def calculate_battery_health(self) -> Dict:
        """Calculate estimated battery health based on history"""
        if len(self.battery_history) < 2:
            return {
                'health_percent': 'N/A',
                'status': 'Insufficient data',
                'charge_cycles': 'Unknown',
                'recommendation': 'Monitor battery for at least 24 hours'
            }
        
        # Calculate charge cycles estimate (rough calculation)
        times_plugged = 0
        for i in range(1, len(self.battery_history)):
            prev = self.battery_history[i-1]
            curr = self.battery_history[i]
            
            # Count transitions from unplugged to plugged
            if not prev.get('power_plugged', False) and curr.get('power_plugged', False):
                times_plugged += 1
        
        # Estimate health based on patterns
        # Ideal battery: 500-1000 cycles, loses ~20% capacity per 200 cycles
        estimated_cycles = times_plugged * 10  # Rough estimate
        health_percent = max(0, 100 - (estimated_cycles / 10))
        
        if health_percent >= 80:
            status = "Excellent"
            recommendation = "Battery is in good condition"
        elif health_percent >= 60:
            status = "Good"
            recommendation = "Battery health is acceptable"
        elif health_percent >= 40:
            status = "Fair"
            recommendation = "Consider replacing battery soon"
        else:
            status = "Poor"
            recommendation = "Battery needs replacement"
        
        return {
            'health_percent': f"{health_percent:.1f}%",
            'status': status,
            'charge_cycles': f"~{estimated_cycles}",
            'recommendation': recommendation
        }
    
    def log_battery_data(self):
        """Log current battery data to CSV file"""
        battery_info = self.get_battery_info()
        
        if not battery_info:
            return
        
        self.current_battery = battery_info
        self.battery_history.append(battery_info)
        
        # Write to CSV
        file_exists = os.path.exists(self.log_file)
        
        try:
            with open(self.log_file, 'a', newline='') as f:
                writer = csv.writer(f)
                
                if not file_exists:
                    writer.writerow(['Timestamp', 'Battery %', 'Power Plugged', 'Time Left (seconds)'])
                
                writer.writerow([
                    battery_info['timestamp'],
                    battery_info['percent'],
                    'Yes' if battery_info['power_plugged'] else 'No',
                    battery_info['time_left'] if battery_info['time_left'] > 0 else 'N/A'
                ])
        except Exception as e:
            print(f"Error logging battery data: {e}")
    
    def save_metrics(self):
        """Save battery metrics to JSON file"""
        metrics = {
            'last_updated': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'current_battery': self.current_battery,
            'health_estimate': self.calculate_battery_health(),
            'log_entries': len(self.battery_history)
        }
        
        try:
            with open(self.data_file, 'w') as f:
                json.dump(metrics, f, indent=2)
        except Exception as e:
            print(f"Error saving metrics: {e}")
    
    def load_history(self):
        """Load battery history from CSV file"""
        if not os.path.exists(self.log_file):
            return
        
        try:
            with open(self.log_file, 'r') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    self.battery_history.append({
                        'timestamp': row['Timestamp'],
                        'percent': float(row['Battery %']),
                        'power_plugged': row['Power Plugged'] == 'Yes',
                        'time_left': float(row['Time Left (seconds)']) if row['Time Left (seconds)'] != 'N/A' else -1
                    })
        except Exception as e:
            print(f"Error loading history: {e}")
    
    def display_current_status(self):
        """Display current battery status"""
        self.log_battery_data()
        
        battery_info = self.current_battery
        
        if not battery_info:
            print("Error: Cannot read battery information")
            return
        
        print(f"\n{'='*80}")
        print(f" BATTERY STATUS ".center(80, "="))
        print(f"{'='*80}\n")
        
        # Current status
        print(f"{'Timestamp':<40} {battery_info['timestamp']}")
        print(f"{'Battery Percentage':<40} {battery_info['percent']:.1f}%")
        print(f"{'AC Power Status':<40} {'Connected' if battery_info['power_plugged'] else 'On Battery'}")
        
        if battery_info['time_left'] > 0:
            hours = battery_info['time_left'] // 3600
            minutes = (battery_info['time_left'] % 3600) // 60
            print(f"{'Estimated Time Left':<40} {int(hours)}h {int(minutes)}m")
        else:
            print(f"{'Estimated Time Left':<40} Charging")
        
        print()
    
    def display_health_estimate(self):
        """Display battery health estimate"""
        health = self.calculate_battery_health()
        
        print(f"{'='*80}")
        print(f" BATTERY HEALTH ESTIMATE ".center(80, "="))
        print(f"{'='*80}\n")
        
        print(f"{'Estimated Health':<40} {health['health_percent']}")
        print(f"{'Status':<40} {health['status']}")
        print(f"{'Estimated Charge Cycles':<40} {health['charge_cycles']}")
        print(f"{'Recommendation':<40} {health['recommendation']}")
        print()
    
    def display_dashboard(self):
        """Display full battery dashboard"""
        self.log_battery_data()
        
        battery_info = self.current_battery
        health = self.calculate_battery_health()
        
        print(f"\n{'='*80}")
        print(f" BATTERY HEALTH MONITOR ".center(80, "="))
        print(f"{'='*80}\n")
        
        # Current status
        print("CURRENT STATUS:")
        print(f"  Timestamp: {battery_info['timestamp']}")
        print(f"  Battery Level: {battery_info['percent']:.1f}%", end='')
        
        # Battery bar
        bar_filled = int(battery_info['percent'] / 5)
        bar = '█' * bar_filled + '░' * (20 - bar_filled)
        print(f" [{bar}]")
        
        print(f"  AC Power: {'Connected' if battery_info['power_plugged'] else 'On Battery'}")
        
        if battery_info['time_left'] > 0:
            hours = battery_info['time_left'] // 3600
            minutes = (battery_info['time_left'] % 3600) // 60
            print(f"  Time Left: {int(hours)}h {int(minutes)}m")
        else:
            print(f"  Status: Charging")
        
        print()
        
        # Health estimate
        print("HEALTH ESTIMATE:")
        print(f"  Estimated Health: {health['health_percent']}")
        print(f"  Status: {health['status']}")
        print(f"  Estimated Cycles: {health['charge_cycles']}")
        print(f"  Recommendation: {health['recommendation']}")
        print()
        
        # Statistics
        if len(self.battery_history) > 0:
            percentages = [b['percent'] for b in self.battery_history]
            print("STATISTICS (from logged data):")
            print(f"  Average Battery: {sum(percentages) / len(percentages):.1f}%")
            print(f"  Max Battery: {max(percentages):.1f}%")
            print(f"  Min Battery: {min(percentages):.1f}%")
            print(f"  Log Entries: {len(self.battery_history)}")
        
        print("\n" + "="*80 + "\n")
    
    def start_continuous_monitoring(self, interval: int = 300):
        """Start continuous battery monitoring (update every N seconds)"""
        print(f"\nMonitoring battery every {interval} seconds...")
        print("Press Ctrl+C to stop\n")
        
        try:
            while True:
                self.display_dashboard()
                self.save_metrics()
                time.sleep(interval)
        except KeyboardInterrupt:
            print("\n\nMonitoring stopped.")
            self.save_metrics()
    
    def show_history(self, last_n: int = 10):
        """Show last N battery log entries"""
        if not self.battery_history:
            print("No battery history available")
            return
        
        print(f"\n{'='*80}")
        print(f" BATTERY HISTORY (Last {last_n} entries) ".center(80, "="))
        print(f"{'='*80}\n")
        
        print(f"{'Timestamp':<25} {'Battery %':<15} {'AC Power':<15} {'Time Left':<15}")
        print("-" * 70)
        
        for entry in self.battery_history[-last_n:]:
            time_left = f"{int(entry['time_left'] // 3600)}h {int((entry['time_left'] % 3600) // 60)}m" if entry['time_left'] > 0 else "Charging"
            print(f"{entry['timestamp']:<25} {entry['percent']:<14.1f}% "
                  f"{'Yes' if entry['power_plugged'] else 'No':<14} {time_left:<15}")
        
        print("\n" + "="*80 + "\n")
    
    def get_battery_report_file(self):
        """Generate Windows battery report"""
        if sys.platform != 'win32':
            print("Battery report generation only works on Windows")
            return
        
        print("\nGenerating battery report...")
        try:
            os.system('powercfg /batteryreport /output:battery_report.html')
            print("Battery report saved as: battery_report.html")
            print("Open the file in your browser to view detailed battery information")
        except Exception as e:
            print(f"Error generating report: {e}")


def main():
    """Main entry point"""
    monitor = BatteryHealthMonitor()
    
    print("\nBattery Health Monitor - Choose option:")
    print("1. Current battery status")
    print("2. Battery health estimate")
    print("3. Full dashboard view")
    print("4. Start continuous monitoring")
    print("5. Battery history")
    print("6. Generate Windows battery report")
    print("7. Exit")
    
    choice = input("\nEnter your choice (1-7): ").strip()
    
    if choice == '1':
        monitor.display_current_status()
        monitor.save_metrics()
    
    elif choice == '2':
        monitor.display_health_estimate()
    
    elif choice == '3':
        monitor.display_dashboard()
        monitor.save_metrics()
    
    elif choice == '4':
        interval = input("Enter monitoring interval in seconds (default 300): ").strip()
        interval = int(interval) if interval.isdigit() else 300
        monitor.start_continuous_monitoring(interval=interval)
    
    elif choice == '5':
        last_n = input("How many entries to show? (default 10): ").strip()
        last_n = int(last_n) if last_n.isdigit() else 10
        monitor.show_history(last_n=last_n)
    
    elif choice == '6':
        monitor.get_battery_report_file()
    
    elif choice == '7':
        print("Exiting...")
    
    else:
        print("Invalid choice!")


if __name__ == "__main__":
    main()

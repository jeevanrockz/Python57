import numpy as np
import matplotlib.pyplot as plt

# -----------------------------
# 1. Environment Setup
# -----------------------------
np.random.seed(42)
n_arms = 5
true_probs = np.random.rand(n_arms)  # true reward probabilities for each arm

def pull_arm(arm):
    """Simulate pulling an arm (slot machine)."""
    return 1 if np.random.rand() < true_probs[arm] else 0

# -----------------------------
# 2. ε-Greedy Strategy
# -----------------------------
def epsilon_greedy(n_trials, epsilon=0.1):
    rewards = np.zeros(n_trials)
    counts = np.zeros(n_arms)
    values = np.zeros(n_arms)
    
    for t in range(n_trials):
        if np.random.rand() < epsilon:
            arm = np.random.randint(n_arms)  # explore
        else:
            arm = np.argmax(values)          # exploit
        
        reward = pull_arm(arm)
        counts[arm] += 1
        values[arm] += (reward - values[arm]) / counts[arm]
        rewards[t] = reward
    
    return rewards

# -----------------------------
# 3. UCB Strategy
# -----------------------------
def ucb(n_trials):
    rewards = np.zeros(n_trials)
    counts = np.zeros(n_arms)
    values = np.zeros(n_arms)
    
    for t in range(n_trials):
        if t < n_arms:
            arm = t  # play each arm once
        else:
            ucb_values = values + np.sqrt(2 * np.log(t) / counts)
            arm = np.argmax(ucb_values)
        
        reward = pull_arm(arm)
        counts[arm] += 1
        values[arm] += (reward - values[arm]) / counts[arm]
        rewards[t] = reward
    
    return rewards

# -----------------------------
# 4. Simulation
# -----------------------------
n_trials = 1000
rewards_eps = epsilon_greedy(n_trials, epsilon=0.1)
rewards_ucb = ucb(n_trials)

# -----------------------------
# 5. Evaluation
# -----------------------------
plt.figure(figsize=(10,6))
plt.plot(np.cumsum(rewards_eps), label="ε-Greedy")
plt.plot(np.cumsum(rewards_ucb), label="UCB")
plt.axhline(y=n_trials * max(true_probs), color="red", linestyle="--", label="Optimal")
plt.xlabel("Trials")
plt.ylabel("Cumulative Reward")
plt.title("Multi-Armed Bandit Simulation")
plt.legend()
plt.show()

print("True arm probabilities:", true_probs)

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load the customer segments you exported earlier
rfm = pd.read_csv("customer_segments.csv", index_col=0)

# Count customers per RFM segment
segment_counts = rfm["RFM_Segment"].value_counts().reset_index()
segment_counts.columns = ["RFM_Segment", "CustomerCount"]

# Plot bar chart
plt.figure(figsize=(12,6))
sns.barplot(data=segment_counts, x="RFM_Segment", y="CustomerCount", palette="viridis")

plt.title("Customer Distribution by RFM Segment")
plt.xlabel("RFM Segment (Recency-Frequency-Monetary)")
plt.ylabel("Number of Customers")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()


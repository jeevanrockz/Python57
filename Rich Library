from rich.progress import Progress
import time

# Create a progress manager
with Progress() as progress:
    # Add multiple tasks
    download_task = progress.add_task("[cyan]Downloading...", total=100)
    training_task = progress.add_task("[magenta]Training Model...", total=50)
    report_task = progress.add_task("[green]Generating Report...", total=30)

    # Simulate progress
    while not progress.finished:
        progress.update(download_task, advance=5)
        progress.update(training_task, advance=2)
        progress.update(report_task, advance=1)
        time.sleep(0.3)

rich with flask:-

from flask import Flask
from rich.table import Table
from rich.console import Console

app = Flask(__name__)
console = Console(record=True)

@app.route("/")
def dashboard():
    table = Table(title="Server Metrics")
    table.add_column("Metric", style="cyan")
    table.add_column("Value", style="green")
    table.add_row("CPU Usage", "42%")
    table.add_row("Memory", "3.2 GB")
    
    # Capture Rich output as HTML
    console.clear()
    console.print(table)
    html_output = console.export_html()
    
    return html_output

if __name__ == "__main__":
    app.run(debug=True)

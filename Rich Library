multi task dashboard:-

from rich.live import Live
from rich.table import Table
from rich.progress import Progress
import time

# Create a progress tracker
progress = Progress()

task1 = progress.add_task("[cyan]Downloading Data...", total=100)
task2 = progress.add_task("[magenta]Training Model...", total=50)
task3 = progress.add_task("[green]Generating Report...", total=30)

def generate_table():
    table = Table(title="Pipeline Status")
    table.add_column("Task", style="cyan")
    table.add_column("Progress", style="magenta")

    table.add_row("Data Download", f"{progress.tasks[0].completed}/{progress.tasks[0].total}")
    table.add_row("Model Training", f"{progress.tasks[1].completed}/{progress.tasks[1].total}")
    table.add_row("Report Generation", f"{progress.tasks[2].completed}/{progress.tasks[2].total}")
    return table

# Live dashboard with progress + table
with Live(progress, refresh_per_second=10) as live:
    while not progress.finished:
        progress.update(task1, advance=5)
        progress.update(task2, advance=2)
        progress.update(task3, advance=1)
        live.update(generate_table())
        time.sleep(0.3)

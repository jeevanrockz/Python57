console dashboard with rich:-

from rich.console import Console
from rich.table import Table
from rich.progress import track
from rich.logging import RichHandler
import logging
import time

# Setup console
console = Console()

# Setup logging with Rich
logging.basicConfig(
    level="INFO", format="%(message)s", datefmt="[%X]", handlers=[RichHandler()]
)
log = logging.getLogger("rich")

# 1. Display a table
table = Table(title="Project Status")
table.add_column("Task", style="cyan", justify="left")
table.add_column("Status", style="magenta", justify="center")

table.add_row("Data Cleaning", "✅ Done")
table.add_row("Model Training", "⏳ In Progress")
table.add_row("Report Generation", "❌ Pending")

console.print(table)

# 2. Progress bar for a loop
for step in track(range(10), description="Training model..."):
    time.sleep(0.3)

# 3. Logging with Rich
log.info("Model training completed successfully!")
log.warning("Report generation delayed due to missing data.")

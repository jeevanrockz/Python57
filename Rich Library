splitting the console into panels:-

from rich.console import Console
from rich.layout import Layout
from rich.panel import Panel
import time

console = Console()

# Create a layout with two sections
layout = Layout()

# Split into top and bottom
layout.split(
    Layout(name="header", size=3),
    Layout(name="body")
)

# Add content to header and body
layout["header"].update(Panel("📊 Rich Dashboard", style="bold magenta"))
layout["body"].split_row(
    Layout(Panel("Left Panel: Logs"), name="left"),
    Layout(Panel("Right Panel: Progress"), name="right")
)

# Display the layout live
with console.screen():
    for i in range(5):
        layout["left"].update(Panel(f"Log entry {i+1}", style="cyan"))
        layout["right"].update(Panel(f"Progress: {20*(i+1)}%", style="green"))
        console.print(layout)
        time.sleep(1)

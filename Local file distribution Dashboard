import os
from flask import Flask, render_template
from collections import Counter

app = Flask(__name__)

# Folder to scan (you can change this to any directory)
SCAN_FOLDER = "C:/Users/jeeva/OneDrive/Documents"

# File type categories
FILE_TYPES = {
    "Images": [".jpg", ".jpeg", ".png", ".gif", ".bmp"],
    "Documents": [".pdf", ".docx", ".doc", ".txt"],
    "Spreadsheets": [".xls", ".xlsx", ".csv"],
    "Audio": [".mp3", ".wav", ".aac"],
    "Videos": [".mp4", ".avi", ".mov", ".mkv"],
    "Others": []
}

def categorize_files(folder):
    counts = Counter()
    for root, _, files in os.walk(folder):
        for file in files:
            ext = os.path.splitext(file)[1].lower()
            found = False
            for category, extensions in FILE_TYPES.items():
                if ext in extensions:
                    counts[category] += 1
                    found = True
                    break
            if not found:
                counts["Others"] += 1
    return counts

@app.route("/")
def index():
    file_counts = categorize_files(SCAN_FOLDER)
    categories = list(file_counts.keys())
    values = list(file_counts.values())
    return render_template("pie.html", categories=categories, values=values)

if __name__ == "__main__":
    app.run(debug=True)


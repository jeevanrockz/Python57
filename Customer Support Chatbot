    """Simulated knowledge base for common support questions."""
    
    def __init__(self):
        self.kb = {
            "return_policy": {
                "question": r"return|refund|exchange",
                "answer": "We offer a 30-day money-back guarantee on all products. "
                         "To initiate a return, go to your account > Orders > 'Return Item'. "
                         "Items must be unused and in original packaging."
            },
            "password_reset": {
                "question": r"password|login|reset|forgot",
                "answer": "Visit our login page and click 'Forgot Password?'. "
                         "Enter your email, and we'll send a reset link within 5 minutes. "
                         "Check your spam folder if you don't see it."
            },
            "shipping": {
                "question": r"shipping|deliver|track|where is my",
                "answer": "Standard shipping takes 5-7 business days. "
                         "You'll receive a tracking number via email once your order ships. "
                         "Express (2-day) and Overnight options are available at checkout."
            },
            "payment": {
                "question": r"payment|charge|credit card|billing",
                "answer": "We accept all major credit cards, PayPal, and Apple Pay. "
                         "All transactions are encrypted and PCI-DSS compliant. "
                         "If you see a duplicate charge, contact support immediately."
            },
            "products": {
                "question": r"product|size|color|available|specs|features",
                "answer": "Our product pages show detailed specs, customer reviews, and sizing guides. "
                         "For PDFs or technical datasheets, check the 'Documents' tab. "
                         "Contact us if you need a format we don't have listed."

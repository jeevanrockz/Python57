#!/usr/bin/env python3
"""
Customer Support Chatbot with Knowledge Base, Order Tracking, and Escalation
Demonstrates real-world use case: handling support queries, API integration,
and intelligent escalation to human agents.
"""
import re
import random
import json
from datetime import datetime, timedelta
from typing import Optional, Dict, List, Tuple
from enum import Enum


class IssueType(Enum):
    """Classify support issues for routing and escalation."""
    ORDER_TRACKING = "order_tracking"
    PASSWORD_RESET = "password_reset"
    RETURN_POLICY = "return_policy"
    BILLING = "billing"
    TECHNICAL = "technical"
    GENERAL = "general"


class OrderStatus(Enum):
    """Simulated order statuses."""
    PENDING = "pending"
    SHIPPED = "shipped"
    IN_TRANSIT = "in_transit"
    DELIVERED = "delivered"
    CANCELLED = "cancelled"



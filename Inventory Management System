from flask import Flask, render_template, request, redirect, url_for
import mysql.connector

app = Flask(__name__)

db_config = {
    "host": "localhost",
    "user": "root",          # replace with your MySQL username
    "password": "password",  # replace with your MySQL password
    "database": "clipboard_db"
}

@app.route("/")
def index():
    conn = mysql.connector.connect(**db_config)
    cursor = conn.cursor()

    # Products by category
    cursor.execute("SELECT category, COUNT(*) FROM products GROUP BY category")
    category_data = cursor.fetchall()

    # Stock levels
    cursor.execute("SELECT name, stock FROM products ORDER BY stock DESC")
    stock_data = cursor.fetchall()

    # Sales trend
    cursor.execute("SELECT date, SUM(sales) FROM products GROUP BY date ORDER BY date")
    sales_data = cursor.fetchall()

    conn.close()

    categories = [row[0] for row in category_data]
    category_counts = [row[1] for row in category_data]
    product_names = [row[0] for row in stock_data]
    stock_values = [row[1] for row in stock_data]
    dates = [str(row[0]) for row in sales_data]
    totals = [row[1] for row in sales_data]

    return render_template("inventory.html",
                           categories=categories,
                           category_counts=category_counts,
                           product_names=product_names,
                           stock_values=stock_values,
                           dates=dates,
                           totals=totals)

@app.route("/add", methods=["POST"])
def add_product():
    name = request.form["name"]
    category = request.form["category"]
    stock = int(request.form["stock"])
    sales = int(request.form["sales"])
    date = request.form["date"]

    conn = mysql.connector.connect(**db_config)
    cursor = conn.cursor()
    cursor.execute("INSERT INTO products (name, category, stock, sales, date) VALUES (%s, %s, %s, %s, %s)",
                   (name, category, stock, sales, date))
    conn.commit()
    conn.close()
    return redirect(url_for("index"))

@app.route("/delete/<int:id>")
def delete_product(id):
    conn = mysql.connector.connect(**db_config)
    cursor = conn.cursor()
    cursor.execute("DELETE FROM products WHERE id=%s", (id,))
    conn.commit()
    conn.close()
    return redirect(url_for("index"))

if __name__ == "__main__":
    app.run(debug=True)


"""
Automatic File Organizer for Downloads Folder
Organizes files by type into subdirectories
"""

import os
import shutil
from pathlib import Path
from datetime import datetime
import logging

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('file_organizer.log'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)

# File type categories
FILE_CATEGORIES = {
    'Documents': ['.pdf', '.docx', '.doc', '.txt', '.xlsx', '.xls', '.pptx', '.ppt', '.odt'],
    'Images': ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.svg', '.ico', '.tiff', '.webp'],
    'Videos': ['.mp4', '.mkv', '.avi', '.mov', '.wmv', '.flv', '.webm', '.m4v'],
    'Audio': ['.mp3', '.wav', '.flac', '.aac', '.wma', '.ogg', '.m4a', '.opus'],
    'Archives': ['.zip', '.rar', '.7z', '.tar', '.gz', '.bz2', '.iso'],
    'Executables': ['.exe', '.msi', '.bat', '.cmd', '.com', '.scr'],
    'Code': ['.py', '.js', '.java', '.cpp', '.c', '.h', '.html', '.css', '.json', '.xml', '.sql', '.sh'],
    'Data': ['.csv', '.json', '.xml', '.sql', '.db', '.sqlite'],
}

def get_downloads_folder():
    """Get the Downloads folder path for the current user."""
    downloads = Path.home() / 'Downloads'
    return downloads

def get_file_category(file_extension):
    """Determine the category of a file based on its extension."""
    file_extension = file_extension.lower()
    for category, extensions in FILE_CATEGORIES.items():
        if file_extension in extensions:
            return category
    return 'Other'

def create_category_folders(downloads_folder):
    """Create category folders in the Downloads directory."""
    for category in FILE_CATEGORIES.keys():
        category_path = downloads_folder / category
        category_path.mkdir(exist_ok=True)
        logger.info(f"Ensured folder exists: {category_path}")

def organize_files(downloads_folder, dry_run=False):
    """
    Organize files in the Downloads folder.
    
    Args:
        downloads_folder: Path to Downloads folder
        dry_run: If True, only show what would be done without making changes
    """
    if not downloads_folder.exists():
        logger.error(f"Downloads folder not found: {downloads_folder}")
        return
    
    files_moved = 0
    files_skipped = 0
    
    logger.info(f"Starting file organization in {downloads_folder}")
    logger.info(f"Dry run mode: {dry_run}")
    
    for item in downloads_folder.iterdir():
        # Skip directories (except those we want to organize)
        if item.is_dir():
            # Skip our created category folders and system folders
            if item.name in FILE_CATEGORIES or item.name.startswith('.'):
                continue
            logger.debug(f"Skipping directory: {item.name}")
            continue
        
        # Skip hidden files
        if item.name.startswith('.'):
            logger.debug(f"Skipping hidden file: {item.name}")
            continue
        
        file_extension = item.suffix
        category = get_file_category(file_extension)
        category_path = downloads_folder / category
        
        # Skip if file is already in its category folder
        if item.parent == category_path:
            logger.debug(f"File already organized: {item.name}")
            files_skipped += 1
            continue
        
        destination = category_path / item.name
        
        # Handle duplicate filenames
        if destination.exists():
            base_name = item.stem
            counter = 1
            while destination.exists():
                new_name = f"{base_name}_{counter}{file_extension}"
                destination = category_path / new_name
                counter += 1
            logger.warning(f"File renamed to avoid conflict: {item.name} -> {new_name}")
        
        if dry_run:
            logger.info(f"[DRY RUN] Would move: {item.name} -> {category}/{item.name}")
            files_moved += 1
        else:
            try:
                shutil.move(str(item), str(destination))
                logger.info(f"Moved: {item.name} -> {category}/{item.name}")
                files_moved += 1
            except Exception as e:
                logger.error(f"Failed to move {item.name}: {str(e)}")
                files_skipped += 1
    
    logger.info(f"Organization complete. Moved: {files_moved}, Skipped: {files_skipped}")
    return files_moved, files_skipped

def main():
    """Main function."""
    import argparse
    
    parser = argparse.ArgumentParser(description='Organize files in Downloads folder')
    parser.add_argument('--dry-run', action='store_true', help='Show what would be done without making changes')
    parser.add_argument('--path', type=str, help='Custom path to organize (defaults to Downloads)')
    
    args = parser.parse_args()
    
    # Get target folder
    if args.path:
        target_folder = Path(args.path)
    else:
        target_folder = get_downloads_folder()
    
    logger.info(f"Target folder: {target_folder}")
    
    # Create category folders
    create_category_folders(target_folder)
    
    # Organize files
    organize_files(target_folder, dry_run=args.dry_run)

if __name__ == '__main__':
    main()

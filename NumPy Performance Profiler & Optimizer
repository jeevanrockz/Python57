import numpy as np
import time
import matplotlib.pyplot as plt
import cProfile

# -----------------------------
# Step 1: Naive vs NumPy Implementations
# -----------------------------

# Matrix Multiplication
def naive_matrix_multiply(A, B):
    n, m = A.shape
    m2, p = B.shape
    result = np.zeros((n, p))
    for i in range(n):
        for j in range(p):
            for k in range(m):
                result[i, j] += A[i, k] * B[k, j]
    return result

def numpy_matrix_multiply(A, B):
    return A @ B

# Sorting
def naive_sort(arr):
    arr = arr.copy()
    for i in range(len(arr)):
        for j in range(i+1, len(arr)):
            if arr[j] < arr[i]:
                arr[i], arr[j] = arr[j], arr[i]
    return arr

def numpy_sort(arr):
    return np.sort(arr)

# Convolution (1D)
def naive_convolution(signal, kernel):
    n = len(signal)
    k = len(kernel)
    result = np.zeros(n-k+1)
    kernel = kernel[::-1]  # reverse kernel to match np.convolve definition
    for i in range(n-k+1):
        for j in range(k):
            result[i] += signal[i+j] * kernel[j]
    return result

def numpy_convolution(signal, kernel):
    return np.convolve(signal, kernel, mode='valid')

# -----------------------------
# Step 2: Benchmarking
# -----------------------------
def benchmark(func, *args, trials=3):
    times = []
    for _ in range(trials):
        start = time.time()
        func(*args)
        end = time.time()
        times.append(end - start)
    return np.mean(times)

# -----------------------------
# Step 3: Profiling
# -----------------------------
def profile_function(func, *args):
    cProfile.runctx("func(*args)", globals(), locals())

# -----------------------------
# Step 4: Testing
# -----------------------------
def test_correctness():
    # Matrix multiplication
    A = np.random.rand(10, 10)
    B = np.random.rand(10, 10)
    assert np.allclose(naive_matrix_multiply(A, B), numpy_matrix_multiply(A, B))

    # Sorting
    arr = np.random.rand(20)
    assert np.allclose(naive_sort(arr), numpy_sort(arr))

    # Convolution
    signal = np.random.rand(30)
    kernel = np.random.rand(5)
    assert np.allclose(naive_convolution(signal, kernel), numpy_convolution(signal, kernel))

    print("All correctness tests passed!")

# -----------------------------
# Step 5: Run Benchmarks
# -----------------------------
def run_benchmarks():
    sizes = [50, 100, 200]
    naive_mm_times, numpy_mm_times = [], []
    naive_sort_times, numpy_sort_times = [], []
    naive_conv_times, numpy_conv_times = [], []

    for n in sizes:
        # Matrix multiplication
        A = np.random.rand(n, n)
        B = np.random.rand(n, n)
        naive_mm_times.append(benchmark(naive_matrix_multiply, A, B))
        numpy_mm_times.append(benchmark(numpy_matrix_multiply, A, B))

        # Sorting
        arr = np.random.rand(n)
        naive_sort_times.append(benchmark(naive_sort, arr))
        numpy_sort_times.append(benchmark(numpy_sort, arr))

        # Convolution
        signal = np.random.rand(n)
        kernel = np.random.rand(10)
        naive_conv_times.append(benchmark(naive_convolution, signal, kernel))
        numpy_conv_times.append(benchmark(numpy_convolution, signal, kernel))

    return sizes, naive_mm_times, numpy_mm_times, naive_sort_times, numpy_sort_times, naive_conv_times, numpy_conv_times

# -----------------------------
# Step 6: Visualization
# -----------------------------
def plot_results(sizes, naive_mm, numpy_mm, naive_sort, numpy_sort, naive_conv, numpy_conv):
    plt.figure(figsize=(15,5))

    # Matrix multiplication
    plt.subplot(1,3,1)
    plt.plot(sizes, naive_mm, label="Naive", marker="o")
    plt.plot(sizes, numpy_mm, label="NumPy", marker="o")
    plt.title("Matrix Multiplication")
    plt.xlabel("Matrix Size (n x n)")
    plt.ylabel("Runtime (s)")
    plt.legend()

    # Sorting
    plt.subplot(1,3,2)
    plt.plot(sizes, naive_sort, label="Naive", marker="o")
    plt.plot(sizes, numpy_sort, label="NumPy", marker="o")
    plt.title("Sorting")
    plt.xlabel("Array Size")
    plt.ylabel("Runtime (s)")
    plt.legend()

    # Convolution
    plt.subplot(1,3,3)
    plt.plot(sizes, naive_conv, label="Naive", marker="o")
    plt.plot(sizes, numpy_conv, label="NumPy", marker="o")
    plt.title("Convolution")
    plt.xlabel("Signal Length")
    plt.ylabel("Runtime (s)")
    plt.legend()

    plt.tight_layout()
    plt.show()

# -----------------------------
# Main Execution
# -----------------------------
if __name__ == "__main__":
    test_correctness()
    sizes, naive_mm, numpy_mm, naive_sort, numpy_sort, naive_conv, numpy_conv = run_benchmarks()
    plot_results(sizes, naive_mm, numpy_mm, naive_sort, numpy_sort, naive_conv, numpy_conv)

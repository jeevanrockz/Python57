from flask import Flask
from loguru import logger

# -------------------------
# Setup Loguru
# -------------------------
# General log file with rotation and retention
logger.add("ecommerce.log", rotation="1 MB", retention="7 days")

# Separate logs for payments and orders using filters
logger.add("payments.log", filter=lambda record: "PAYMENT" in record["message"])
logger.add("orders.log", filter=lambda record: "ORDER" in record["message"])

# -------------------------
# Flask App
# -------------------------
app = Flask(__name__)

@app.route("/")
def home():
    logger.info("Home route accessed")
    return "Welcome to the Flask app!"

@app.route("/error")
def error_route():
    try:
        1 / 0
    except Exception:
        logger.exception("Error occurred in /error route")
    return "Error handled gracefully"

# -------------------------
# Users Module
# -------------------------
def register_user(user_id, name):
    logger.bind(user=user_id).info(f"USER Registered: {name}")
    return {"user_id": user_id, "name": name}

def login_user(user_id):
    logger.bind(user=user_id).info("USER Login successful")
    return True

# -------------------------
# Orders Module
# -------------------------
def place_order(order_id, user_id, item):
    logger.bind(user=user_id).info(f"ORDER Placed: {order_id} - {item}")
    return {"order_id": order_id, "item": item}

# -------------------------
# Payments Module
# -------------------------
@logger.catch
def process_payment(order_id, amount):
    if amount <= 0:
        raise ValueError("Invalid payment amount")
    logger.info(f"PAYMENT Processed: Order {order_id}, Amount {amount}")
    return True

# -------------------------
# Main Application
# -------------------------
if __name__ == "__main__":
    # Simulate workflow
    user = register_user(1, "Jeevan")
    login_user(user["user_id"])
    order = place_order(101, user["user_id"], "Laptop")
    process_payment(order["order_id"], 50000)
    process_payment(order["order_id"], 0)  # This will trigger an exception

    # Start Flask server
    logger.info("Starting Flask server...")
    app.run(debug=True)

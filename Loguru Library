integrating with flask:-

from flask import Flask
from loguru import logger

app = Flask(__name__)

# Configure Loguru to log to both console and file
logger.add("server.log", rotation="500 KB", retention="10 days")

@app.route("/")
def home():
    logger.info("Home route accessed")
    return "Welcome to the Flask app!"

@app.route("/error")
def error_route():
    try:
        1 / 0
    except Exception:
        logger.exception("Error occurred in /error route")
    return "Error handled gracefully"

if __name__ == "__main__":
    logger.info("Starting Flask server...")
    app.run(debug=True)
